# ============================================================================
# UCASAL - Retiro de la landing de AGOSTO
# ============================================================================
#
# Este archivo REEMPLAZA al .htaccess que traia la landing de agosto (repo
# landing-agosto), que hacia el rewrite a index.html para react-router. Al
# reemplazarlo, la SPA de agosto deja de servirse y todo el arbol redirige 301
# a la landing de primer ingreso, para que los leads de las campanias viejas
# entren a la web nueva.
#
# Va aca y no solo en el .htaccess de /landing/ porque un .htaccess hijo no
# hereda las RewriteRule del padre y mod_rewrite corre antes que mod_alias: si
# quedara el rewrite de la SPA, ganaria el y los Redirect del padre nunca
# verian la URL original.
#
# ----------------------------------------------------------------------------
# DESTINO: el build MIXTO (/landing/ingreso/carreras/)
# ----------------------------------------------------------------------------
#
# Las 24 carreras van al build de .env.presencial, no al de .env.online. Ese es
# el que ofrece las dos modalidades: su `modosCarrera` es [1, 7], asi que la
# carrera llega entera al detalle y CareerDetail.astro la muestra como
# "Presencial y Online" (ahi `mixta` es true). El build online recorta cada
# carrera a [7] en carrerasLanding.ts, y por eso anunciaba solo Online.
#
# De las 24, segun su `modalidad` en src/data/carreras.ts:
#
#   13 son [1, 7] -> se ven como "Presencial y Online". Es el caso que motiva
#                    apuntar aca.
#   10 son [7]    -> el build mixto igual les genera pagina (7 esta en [1, 7]),
#                    y muestran solo Online porque no hay nada mixto que
#                    mostrar. Mismo contenido que antes, otra base.
#    1 es [1]     -> topografia y geomatica, que solo existe en este build.
#
# Como las 24 caen en la misma base, no hace falta ninguna excepcion: un slug,
# una regla, todas al mismo lugar.
#
# Los slug de agosto y los de src/data/carreras.ts son identicos, asi que lo
# unico que cambia es la base. mod_rewrite arrastra el query string cuando la
# sustitucion no trae uno propio, asi que los utm_* de agosto se conservan.
#
# Los destinos llevan barra final a proposito: Astro buildea en formato
# directorio (abogacia/index.html), asi que sin la barra Apache agrega un 301
# propio de mod_dir y el visitante come dos saltos en vez de uno. Verificado
# contra produccion: .../abogacia devuelve 301 y .../abogacia/ devuelve 200.
#
# Si en algun momento se borra la carpeta carreras-agosto del servidor, este
# archivo desaparece con ella y toma el relevo el BLOQUE 3 del .htaccess de
# /landing/, que tiene las mismas reglas en formato RedirectMatch.

RewriteEngine On

# ----------------------------------------------------------------------------
# 1 - Las 24 carreras de agosto -> build mixto, mismo slug
# ----------------------------------------------------------------------------

RewriteRule ^abogacia/?$                                                                 /landing/ingreso/carreras/abogacia/ [R=301,L]
RewriteRule ^administracion-agropecuaria/?$                                              /landing/ingreso/carreras/administracion-agropecuaria/ [R=301,L]
RewriteRule ^administracion-de-empresas/?$                                               /landing/ingreso/carreras/administracion-de-empresas/ [R=301,L]
RewriteRule ^administracion-de-negocios-digitales/?$                                     /landing/ingreso/carreras/administracion-de-negocios-digitales/ [R=301,L]
RewriteRule ^comercializacion/?$                                                         /landing/ingreso/carreras/comercializacion/ [R=301,L]
RewriteRule ^comercio-internacional/?$                                                   /landing/ingreso/carreras/comercio-internacional/ [R=301,L]
RewriteRule ^contador-publico/?$                                                         /landing/ingreso/carreras/contador-publico/ [R=301,L]
RewriteRule ^corredor-inmobiliario-y-martillero-publico/?$                               /landing/ingreso/carreras/corredor-inmobiliario-y-martillero-publico/ [R=301,L]
RewriteRule ^economia/?$                                                                 /landing/ingreso/carreras/economia/ [R=301,L]
RewriteRule ^escribania/?$                                                               /landing/ingreso/carreras/escribania/ [R=301,L]
RewriteRule ^guia-universitario-de-turismo/?$                                            /landing/ingreso/carreras/guia-universitario-de-turismo/ [R=301,L]
RewriteRule ^higiene-y-seguridad/?$                                                      /landing/ingreso/carreras/higiene-y-seguridad/ [R=301,L]
RewriteRule ^licenciatura-en-ciencia-de-datos/?$                                         /landing/ingreso/carreras/licenciatura-en-ciencia-de-datos/ [R=301,L]
RewriteRule ^licenciatura-en-corretaje-tasacion-y-administracion-de-consorcios/?$        /landing/ingreso/carreras/licenciatura-en-corretaje-tasacion-y-administracion-de-consorcios/ [R=301,L]
RewriteRule ^licenciatura-en-seguridad/?$                                                /landing/ingreso/carreras/licenciatura-en-seguridad/ [R=301,L]
RewriteRule ^procuracion/?$                                                              /landing/ingreso/carreras/procuracion/ [R=301,L]
RewriteRule ^recursos-humanos/?$                                                         /landing/ingreso/carreras/recursos-humanos/ [R=301,L]
RewriteRule ^tec-universitaria-en-gestion-de-bancos-empresas-financieras-y-de-seguros/?$ /landing/ingreso/carreras/tec-universitaria-en-gestion-de-bancos-empresas-financieras-y-de-seguros/ [R=301,L]
RewriteRule ^tecn-univ-en-organizacion-y-direccion-de-eventos-y-ceremonial/?$            /landing/ingreso/carreras/tecn-univ-en-organizacion-y-direccion-de-eventos-y-ceremonial/ [R=301,L]
RewriteRule ^tecnicatura-en-operaciones-mineras-e-industriales/?$                        /landing/ingreso/carreras/tecnicatura-en-operaciones-mineras-e-industriales/ [R=301,L]
RewriteRule ^tecnicatura-en-seguridad-informatica/?$                                     /landing/ingreso/carreras/tecnicatura-en-seguridad-informatica/ [R=301,L]
RewriteRule ^tecnicatura-univ-en-gestion-de-calidad/?$                                   /landing/ingreso/carreras/tecnicatura-univ-en-gestion-de-calidad/ [R=301,L]
RewriteRule ^tecnicatura-univ-en-secretariado-ejecutivo/?$                               /landing/ingreso/carreras/tecnicatura-univ-en-secretariado-ejecutivo/ [R=301,L]
RewriteRule ^tecnicatura-universitaria-topografia-y-geomatica/?$                         /landing/ingreso/carreras/tecnicatura-universitaria-topografia-y-geomatica/ [R=301,L]

# ----------------------------------------------------------------------------
# 2 - Todo lo demas -> home del build mixto
# ----------------------------------------------------------------------------
# Cubre la home de agosto, /enviado-agosto, /enviado/<slug>, /404, los assets
# viejos y cualquier slug que no este arriba. Mejor la home nueva que un 404:
# el lead sigue en la pagina y puede elegir carrera.

RewriteRule ^ /landing/ingreso/carreras/ [R=301,L]
