# Configuración del build ONLINE.
#
# Este archivo se versiona a propósito: no guarda secretos, solo qué variante de
# la landing se arma. Lo carga `astro build --mode online` (ver package.json).
#
# Todo lo que cambia entre modalidades vive acá, en src/config/modalidad.ts
# (flags y modos de cursado) o en src/config/contenido.ts (textos).

# Variante de la landing: presencial | online
PUBLIC_MODALIDAD=online

# Ruta desde la que se sirve este build. Tiene que terminar con "/".
RUTA_BASE=/landing/ingreso/carreras-online/
CARPETA_BUILD=dist/carreras-online/