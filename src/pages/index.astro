---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Hero from '../components/astro/Hero.astro';
import Beneficios from '../components/astro/Beneficios.astro';
import ModalidadesPuerta from '../components/astro/ModalidadesPuerta.astro';
import Financiacion from '../components/astro/Financiacion.astro';
import Faq from '../components/astro/Faq.astro';
import Footer from '../components/astro/Footer.astro';
import ExploradorCarreras from '../components/react/ExploradorCarreras.tsx';
import Form from '../components/react/Form.tsx';
import data from '../data/carreras';

const base = import.meta.env.BASE_URL;
---

<Layout title="Primer ingreso | Estudiá en UCASAL" description="Encontrá tu carrera, elegí tu modalidad y comenzá tu camino universitario en UCASAL.">
    <Navbar onSubPage={false} />
        <Hero base={base} />
        <Beneficios />
        <ModalidadesPuerta client:load />
        <ExploradorCarreras careers={data} client:visible />
        <Financiacion />
        <Faq />
        <Form onSubPage={false} client:visible />
    <Footer />
</Layout>
