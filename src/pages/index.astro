---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Hero from "../components/astro/Hero.astro";
import BeneficiosCartas from "../components/astro/BeneficiosCartas.astro";
import ModalidadesPuerta from "../components/astro/ModalidadesPuerta.astro";
import Sedes from "../components/astro/Sedes.astro";
import Testimonios from "../components/astro/Testimonios.astro";
import Footer from "../components/astro/Footer.astro";
import ExploradorCarreras from "../components/react/ExploradorCarreras.tsx";
import FormSection from "../components/astro/FormSection.astro";
import carreras from "../data/carrerasLanding";
import { modosCarrera } from "../config/modalidad";
import { getImage } from "astro:assets";
import portadaDesktop from "../assets/portada/desktop.webp";
import portadaMobile from "../assets/portada/mobile.webp";

const base = import.meta.env.BASE_URL;

// La portada son dos recortes distintos (vertical en mobile, horizontal en
// desktop), así que no alcanza un `<Picture>`: hace falta el `<picture>` a mano
// para poder usar `media`. `getImage` igual nos da el srcset con los tamaños
// intermedios y el avif, que es lo que baja el peso de estos dos archivos de
// ~1 MB cada uno.
const [
  portadaAvifDesktop,
  portadaAvifMobile,
  portadaWebpDesktop,
  portadaWebpMobile,
] = await Promise.all([
  getImage({
    src: portadaDesktop,
    format: "avif",
    quality: 45,
    widths: [1024, 1440, 1920, 2048],
  }),
  getImage({
    src: portadaMobile,
    format: "avif",
    quality: 45,
    widths: [640, 828, 1080],
  }),
  getImage({
    src: portadaDesktop,
    format: "webp",
    widths: [1024, 1440, 1920, 2048],
  }),
  getImage({
    src: portadaMobile,
    format: "webp",
    widths: [640, 828, 1080, 1236],
  }),
]);
---

<Layout
  title="Primer ingreso | Estudiá en UCASAL"
  description="Encontrá tu carrera, elegí tu modalidad y comenzá tu camino universitario en UCASAL."
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={portadaAvifDesktop.src}
      imagesrcset={portadaAvifDesktop.srcSet.attribute}
      imagesizes="100vw"
      media="(min-width: 769px)"
      type="image/avif"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={portadaAvifMobile.src}
      imagesrcset={portadaAvifMobile.srcSet.attribute}
      imagesizes="100vw"
      media="(max-width: 768px)"
      type="image/avif"
      fetchpriority="high"
    />
  </Fragment>
  <Navbar onSubPage={false} />
  <div class="relative isolate">
    <!-- Fondo compartido: una sola imagen para las dos secciones -->
    <div class="absolute inset-0 -z-10">
      <picture>
        <source
          media="(min-width: 769px)"
          type="image/avif"
          srcset={portadaAvifDesktop.srcSet.attribute}
          sizes="100vw"
        />
        <source
          media="(min-width: 769px)"
          type="image/webp"
          srcset={portadaWebpDesktop.srcSet.attribute}
          sizes="100vw"
        />
        <source
          type="image/avif"
          srcset={portadaAvifMobile.srcSet.attribute}
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset={portadaWebpMobile.srcSet.attribute}
          sizes="100vw"
        />
        <img
          src={portadaWebpMobile.src}
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="sticky left-1/2 right-1/2 top-0 h-dvh w-full object-cover"
        />
      </picture>
      <div class="absolute inset-0 bg-linear-to-t from-transparent to-black/30">
      </div>
    </div>

    <Hero base={base} />
    <BeneficiosCartas base={base} />
  </div>
  <ModalidadesPuerta />
  <ExploradorCarreras
    careers={carreras}
    modosDisponibles={modosCarrera}
    client:visible
  />
  <!-- A partir de acá el scroll es normal: el observer del Layout apaga el
         snap mientras esta zona esté en pantalla. -->
  <Sedes />
  <div data-scroll-libre>
    <!-- Vamos a hacer que compartan el mismo fondo, el que me paso la fer me gustaba banda -->
    <div class="relative isolate">
      <div class="absolute inset-0 -z-10">
        <img
          src={`${base}fondos/azul.webp`}
          alt="Imagen de fondo azul"
          class="sticky left-1/2 right-1/2 top-0 h-full w-full object-cover"
        />
      </div>
      <FormSection />
      {
        /* La cinta de convenios ya va adentro de Testimonios, en el mismo
                   panel oscuro. */
      }
      <Testimonios />
    </div>
    <Footer />
  </div>
</Layout>
