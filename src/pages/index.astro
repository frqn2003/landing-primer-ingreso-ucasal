---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Hero from "../components/astro/Hero.astro";
import BeneficiosCartas from "../components/astro/BeneficiosCartas.astro";
import ModalidadesPuerta from "../components/astro/ModalidadesPuerta.astro";
import Financiacion from "../components/astro/Financiacion.astro";
import Sedes from "../components/astro/Sedes.astro";
import Testimonios from "../components/astro/Testimonios.astro";
import Footer from "../components/astro/Footer.astro";
import ExploradorCarreras from "../components/react/ExploradorCarreras.tsx";
import FormSection from "../components/astro/FormSection.astro";
import carreras from "../data/carrerasLanding";
import { modosCarrera } from "../config/modalidad";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Primer ingreso | Estudiá en UCASAL"
  description="Encontrá tu carrera, elegí tu modalidad y comenzá tu camino universitario en UCASAL."
>
  <Navbar onSubPage={false} />
  <div class="relative isolate">
    <!-- Fondo compartido: una sola imagen para las dos secciones -->
    <div class="absolute inset-0 -z-10">
      <picture>
        <source
          media="(min-width: 769px)"
          srcset={`${base}encabezados/portada/desktop.webp`}
        />
        <img
          src={`${base}encabezados/portada/mobile.webp`}
          alt=""
          class="sticky left-1/2 right-1/2 top-0 h-dvh w-full object-cover"
        />
      </picture>
      <div class="absolute inset-0 bg-linear-to-t from-transparent to-black/30">
      </div>
    </div>

    <Hero base={base} />
    <BeneficiosCartas base={base} />
  </div>
  <ModalidadesPuerta />
  <ExploradorCarreras
    careers={carreras}
    modosDisponibles={modosCarrera}
    client:visible
  />
  <!-- A partir de acá el scroll es normal: el observer del Layout apaga el
         snap mientras esta zona esté en pantalla. -->
  <Sedes />
  <div data-scroll-libre>
    <!-- Vamos a hacer que compartan el mismo fondo, el que me paso la fer me gustaba banda -->
    <div class="relative isolate">
      <div class="absolute inset-0 -z-10">
        <img
          src={`${base}fondos/azul.jpg`}
          alt="Imagen de fondo azul"
          class="sticky left-1/2 right-1/2 top-0 h-full w-full object-cover"
        />
      </div>
      <FormSection />
      {
        /* La cinta de convenios ya va adentro de Testimonios, en el mismo
                   panel oscuro. */
      }
      <Testimonios />
    </div>
    <Footer />
  </div>
</Layout>
