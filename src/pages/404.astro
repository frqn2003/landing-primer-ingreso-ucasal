---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada | Primer ingreso UCASAL" description="La página que buscás no está disponible.">
    <main class="grid min-h-screen place-items-center bg-slate-50 px-6 text-center"><div><p class="text-sm font-bold uppercase tracking-[0.2em] text-(--rojo-ucasal)">404</p><h1 class="mt-3 text-4xl font-black text-(--azul-dark-ucasal)">Página no encontrada</h1><p class="mt-4 text-slate-600">Volvé al inicio para seguir explorando las carreras.</p><a href={import.meta.env.BASE_URL} class="mt-7 inline-flex rounded-xl bg-(--azul-dark-ucasal) px-5 py-3 font-bold text-white">Ir al inicio</a></div></main>
</Layout>
