---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
import { esOnline } from '../config/modalidad';

// El resumen se arma en el navegador con lo que viene por querystring (lo manda
// Form.tsx al redirigir). Las etiquetas salen de acá para que el build online no
// lleve la palabra "Presencial" ni en el script: ahí el único modo posible es el 7.
const etiquetasModo: Record<string, string> = esOnline
    ? { '7': 'Online' }
    : { '1': 'Presencial', '7': 'Online' };

const base = import.meta.env.BASE_URL;
const linkInscripcion =
    'https://www.ucasal.edu.ar/inscripciones/?utm_source=landing_primer_ingreso&utm_medium=gracias';

const redes = [
    { nombre: 'Facebook', url: 'https://www.facebook.com/Ucasal', color: '#1877F2', path: 'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z' },
    { nombre: 'YouTube', url: 'https://www.youtube.com/@ucasal', color: '#FF0000', path: 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
    { nombre: 'Instagram', url: 'https://www.instagram.com/ucasal/', color: '#E1306C', path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
    { nombre: 'TikTok', url: 'https://www.tiktok.com/@ucasal', color: '#000000', path: 'M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z' },
    { nombre: 'LinkedIn', url: 'https://ar.linkedin.com/school/ucasal-oficial/', color: '#0A66C2', path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
    { nombre: 'X', url: 'https://x.com/UcasalOficial', color: '#000000', path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
];

// Iconos de cada fila del resumen, indexados por la clave del querystring. Los
// arma el script de abajo, que es el que sabe qué campos llegaron.
const iconos: Record<string, string[]> = {
    nombre: ['M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'],
    email: ['M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'],
    carrera: [
        'M12 14l9-5-9-5-9 5 9 5z',
        'M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z',
    ],
    modo: ['M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'],
    sede: [
        'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z',
        'M15 11a3 3 0 11-6 0 3 3 0 016 0z',
    ],
};
---

<Layout
    title="Gracias por contactarnos | Primer ingreso UCASAL"
    description="Recibimos tu consulta sobre Primer Ingreso en UCASAL."
>    <main>
        <div
            class="contenedor flex min-h-[70vh] flex-col items-center justify-center gap-8 bg-linear-to-br from-blue-400 via-white to-red-400 pt-28 pb-16"
        >
            {/* Check animado */}
            <div class="relative">
                <div
                    class="flex size-24 items-center justify-center rounded-full bg-(--azul-ucasal) shadow-2xl animate-[heroFadeInUp_0.5s_ease-out_forwards]"
                >
                    <svg class="size-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <div class="absolute -top-1 -right-1 size-6 rounded-full bg-(--rojo-ucasal) animate-bounce"></div>
            </div>

            {/* Título */}
            <div class="max-w-xl text-center" style="opacity: 0; animation: heroFadeInUp 0.6s ease-out 0.2s forwards;">
                <h1 class="mb-3 text-4xl font-extrabold degrade-azul md:text-5xl">
                    ¡Gracias<span id="gracias-nombre"></span>!
                </h1>
                <p class="text-lg text-gray-500">
                    Recibimos tu solicitud correctamente. Un asesor se va a comunicar con vos a la brevedad.
                </p>
            </div>

            {/* Resumen de lo que envió. Arranca oculto: si no vino nada por
                querystring, no se muestra una tarjeta vacía. */}
            <div
                id="resumen-solicitud"
                class="hidden w-full max-w-md rounded-2xl border border-gray-100 bg-white p-6 shadow-xl md:p-8"
                style="opacity: 0; animation: heroFadeInUp 0.6s ease-out 0.4s forwards;"
            >
                <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-400">Resumen de tu solicitud</h2>
                <ul id="resumen-lista" class="flex flex-col gap-4"></ul>
            </div>

            <a
                href={linkInscripcion}
                target="_blank"
                rel="noopener noreferrer"
                class="boton-cta inline-flex w-full max-w-md justify-center"
                style="opacity: 0; animation: heroFadeInUp 0.6s ease-out 0.5s forwards;"
            >
                Inscribirme ahora
            </a>

            {/* Redes sociales */}
            <div class="flex flex-col items-center gap-3" style="opacity: 0; animation: heroFadeInUp 0.6s ease-out 0.7s forwards;">
                <p class="text-sm font-semibold uppercase tracking-widest text-gray-500">Seguinos en redes</p>
                <div class="flex flex-wrap items-center justify-center gap-4">
                    {
                        redes.map((red) => (
                            <a
                                href={red.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={red.nombre}
                                class="flex size-10 items-center justify-center rounded-full border border-gray-100 bg-white text-gray-600 shadow transition-colors hover:text-(--color-red) hover:border-(--color-red)"
                                style={`--color-red: ${red.color};`}
                            >
                                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d={red.path} />
                                </svg>
                            </a>
                        ))
                    }
                </div>
            </div>

            {/* Volver */}
            <div style="opacity: 0; animation: heroFadeInUp 0.6s ease-out 0.8s forwards;">
                <a href={`${base}#carreras`} class="boton-cta inline-flex items-center gap-2">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Explorar más carreras
                </a>
            </div>
        </div>
    </main>
    <Footer />
</Layout>

<script is:inline define:vars={{ etiquetasModo, iconos }}>
    window.scrollTo({ top: 0, behavior: "instant" });

    const params = new URLSearchParams(window.location.search);

    // El querystring lo controla quien abre el link, así que todo lo que termina
    // en innerHTML pasa por acá antes.
    const escapar = (texto) =>
        String(texto).replace(
            /[&<>"']/g,
            (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c],
        );

    const nombre = params.get("nombre");
    if (nombre) {
        const primerNombre = nombre.trim().split(" ")[0];
        if (primerNombre) {
            document.getElementById("gracias-nombre").textContent = `, ${primerNombre}`;
        }
    }

    const campos = [
        ["nombre", "Nombre"],
        ["email", "Email"],
        ["carrera", "Carrera"],
        ["modo", "Modalidad", (v) => etiquetasModo[v] ?? "Consultar modalidad"],
        ["sede", "Sede"],
    ];

    const items = campos
        .map(([clave, etiqueta, formato]) => {
            const valor = params.get(clave);
            if (!valor) return null;
            const texto = formato ? formato(valor) : valor;
            const paths = (iconos[clave] ?? [])
                .map((d) => `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${d}" />`)
                .join("");
            return `<li class="flex items-start gap-3">
                <div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-(--azul-ucasal)/10">
                    <svg class="size-4 text-(--azul-ucasal)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">${paths}</svg>
                </div>
                <div>
                    <p class="text-xs text-gray-400">${etiqueta}</p>
                    <p class="text-sm font-semibold text-gray-800">${escapar(texto)}</p>
                </div>
            </li>`;
        })
        .filter(Boolean);

    if (items.length > 0) {
        document.getElementById("resumen-lista").innerHTML = items.join("");
        document.getElementById("resumen-solicitud").classList.remove("hidden");
    }
</script>
