---
import '../styles/global.css';
import scrappingOnline from '../assets/scrapping/scrapping-online.webp';
import scrappingPresencial from '../assets/scrapping/scrapping-presencial.webp';
import { modalidad } from '../config/modalidad';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Primer ingreso | Estudiá en UCASAL',
	description = 'Encontrá tu carrera, elegí tu modalidad y comenzá tu camino universitario en UCASAL.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://www.ucasal.edu.ar').href;
const base = import.meta.env.BASE_URL;
const socialImageAsset = modalidad === 'online' ? scrappingOnline : scrappingPresencial;
const socialImage = new URL(socialImageAsset.src, 'https://www.ucasal.edu.ar').href;

// Las @font-face se generan acá y no en global.css porque la ruta de los .woff2
// depende del `base`, que cambia según la modalidad del build, y el CSS plano no
// puede leerlo. Las dos últimas familias son alias que ya usaban componentes
// viejos; se mantienen para no romperlos.
const fuentes = [
	{ familia: 'Museo Sans', peso: 500, archivo: 'MuseoSans_500.woff2', local: true },
	{ familia: 'Museo Sans', peso: 700, archivo: 'MuseoSans_700.woff2', local: true },
	{ familia: 'Museo Sans', peso: 900, archivo: 'MuseoSans_900.woff2', local: true },
	{ familia: 'Museo', peso: 300, archivo: 'Museo300-Regular.woff2', local: false },
	{ familia: 'Museo Sans 900', peso: 300, archivo: 'MuseoSans_900.woff2', local: true },
	{ familia: 'Museo Sans 500', peso: 300, archivo: 'MuseoSans_500.woff2', local: true },
];

const cssFuentes = fuentes
	.map(({ familia, peso, archivo, local }) => {
		const origenes = [
			local && `local("${familia}")`,
			`url("${base}fonts/${archivo}") format("woff2")`,
		].filter(Boolean);

		return `@font-face{font-family:"${familia}";font-style:normal;font-weight:${peso};font-display:swap;src:${origenes.join(",")}}`;
	})
	.join('');
---

<!doctype html>
<html lang="es">
	<head>
		<meta name="generator" content={Astro.generator} />
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href={`${base}iso.svg`} />

		<!-- Los snippets de Google van tal cual los entrega Google, sin las llaves
		     ni el template literal de JSX: adentro de un <script> de Astro el
		     contenido es texto plano, así que `{\`...\`}` no interpola nada. Lo que
		     salía al HTML era un bloque con un string adentro —JavaScript válido,
		     pero que no ejecuta la IIFE— y por eso no cargaba ninguna etiqueta.
		     `is:inline` mantiene los tags como están: sin bundlear ni diferir, que
		     es lo que necesita un script de terceros en el <head>. -->

		<!-- Google tag (gtag.js) -->
		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-FWEL0PZRJD"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-FWEL0PZRJD');
		</script>
		<!-- End Google tag (gtag.js) -->

		<!-- Google Tag Manager -->
		<script is:inline>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', 'GTM-T6PB8G');
		</script>
		<!-- End Google Tag Manager -->

		<style is:global set:html={cssFuentes}></style>
		<slot name="head" />

		<!-- SEO -->
		<title>{title}</title>
		<meta
			name="description"
			content={description}
		/>
		<meta name="author" content="Universidad Católica de Salta - UCASAL" />
		<link
			rel="canonical"
			href={canonical}
		/>

		<!-- OG -->
		<meta property="og:type" content="website" />
		<meta
			property="og:url"
			content={canonical}
		/>
		<meta
			property="og:title"
			content={title}
		/>
		<meta
			property="og:description"
			content={description}
		/>
		<meta
			property="og:image"
			content={socialImage}
		/>
		<meta
			property="og:site_name"
			content="UCASAL - Universidad Católica de Salta"
		/>

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta
			name="twitter:title"
			content={title}
		/>
		<meta
			name="twitter:description"
			content={description}
		/>
		<meta
			name="twitter:image:src"
			content={socialImage}
		/>
		<meta name="twitter:site" content="@UcasalOficial" />
		
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript>
			<iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-T6PB8G"
				height="0"
				width="0"
				style="display:none;visibility:hidden"
			></iframe>
		</noscript>
		<!-- End Google Tag Manager (noscript) -->
		<slot />
		<script>
			// El snap obligatorio no puede convivir con secciones más altas que la
			// pantalla: no hay punto de snap intermedio, así que cada gesto se
			// revierte. Solución: apagarlo en el contenedor una vez que la zona de
			// scroll libre llega al tope de la pantalla.
			//
			// Ojo: no sirve un IntersectionObserver sobre la zona libre. Mientras el
			// snap está activo, la zona nunca alcanza a hacerse visible (el snap la
			// revierte primero), así que el observer no se dispararía nunca y el
			// scroll quedaría trabado en la última sección.
			const libre = document.querySelector('[data-scroll-libre]');

			if (libre) {
				const html = document.documentElement;
				let limite = 0;
				let pendiente = false;

				const medir = () => {
					limite = libre.getBoundingClientRect().top + window.scrollY;
				};

				const aplicar = () => {
					pendiente = false;
					html.classList.toggle('snap-off', window.scrollY >= limite - 1);
				};

				const pedir = () => {
					if (pendiente) return;
					pendiente = true;
					requestAnimationFrame(aplicar);
				};

				medir();
				aplicar();

				addEventListener('scroll', pedir, { passive: true });
				addEventListener('resize', () => {
					medir();
					pedir();
				});
			}
		</script>
	</body>
</html>
