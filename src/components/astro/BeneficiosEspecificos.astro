---
import { Image } from "astro:assets";
import type { BeneficioEspecifico } from "../../data/beneficiosEspecificos";

interface Props {
  beneficios: BeneficioEspecifico[];
  carrera: string;
}

const { beneficios, carrera } = Astro.props;
---

<section class="beneficios-especificos mt-8" aria-label={`Experiencias de ${carrera}`}>
  <h2 class="text-(--azul-dark-ucasal)">Experiencias de {carrera}</h2>
  <div
    class="carrusel"
    data-beneficios-especificos
    role="group"
    aria-roledescription="carrusel"
    aria-label={`Experiencias de ${carrera}`}
  >
    <div class="pista" data-pista tabindex="0" aria-label="Deslizá para ver las experiencias">
      {
        beneficios.map((beneficio, index) => (
          <article
            class="diapositiva"
            role="group"
            aria-roledescription="diapositiva"
            aria-label={`${index + 1} de ${beneficios.length}`}
          >
            <Image
              src={beneficio.imagen}
              alt={beneficio.alt}
              width={768}
              widths={[320, 540, 768]}
              sizes="(min-width: 640px) 540px, calc(100vw - 2rem)"
              loading="lazy"
              class="foto"
            />
            {beneficio.ilustrativa && <span class="ilustrativa">Imagen ilustrativa</span>}
            <div class="texto">
              <h4>{beneficio.titulo}</h4>
              <p>{beneficio.descripcion}</p>
            </div>
          </article>
        ))
      }
    </div>

    {
      beneficios.length > 1 && (
        <div class="controles" data-controles>
          <button type="button" class="flecha" data-anterior aria-label="Experiencia anterior">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M15 18l-6-6 6-6" />
            </svg>
          </button>
          <div class="puntos" aria-label="Elegir experiencia">
            {beneficios.map((beneficio, index) => (
              <button
                type="button"
                class="punto"
                data-punto
                aria-label={`Ver ${beneficio.titulo}`}
                aria-current={index === 0 ? "true" : "false"}
              />
            ))}
          </div>
          <button type="button" class="flecha" data-siguiente aria-label="Experiencia siguiente">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>
          <span class="contador" data-contador aria-live="polite">1 / {beneficios.length}</span>
        </div>
      )
    }
  </div>
</section>

<style>
  .carrusel {
    max-width: 100%;
    margin-top: 20px;
  }

  .pista {
    display: flex;
    align-items: center;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    border-radius: 1.25rem;
    outline-offset: 4px;
  }

  [data-listo] .pista {
    scrollbar-width: none;
  }

  [data-listo] .pista::-webkit-scrollbar {
    display: none;
  }

  .diapositiva {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--azul-dark-ucasal);
  }

  .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ilustrativa {
    position: absolute;
    top: 1rem;
    left: 1rem;
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    background: rgb(2 33 48 / 0.78);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .texto {
    position: absolute;
    inset: auto 0 0;
    max-height: 100%;
    overflow-y: auto;
    padding: 3.5rem 1.25rem 1.25rem;
    background: linear-gradient(to top, rgb(2 33 48 / 0.98) 5%, rgb(2 33 48 / 0.82) 65%, transparent);
    color: white;
  }

  .texto h4 {
    font-size: clamp(1.2rem, 4vw, 1.6rem);
    line-height: 1.15;
    font-weight: bold;
  }

  .texto p {
    margin-top: 0.5rem;
    font-size: clamp(0.875rem, 2vw, 0.9rem);
    line-height: 1.45;
  }

  .controles {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  [data-listo] .controles {
    display: flex;
  }

  .flecha {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid #cbd5e1;
    border-radius: 50%;
    color: var(--azul-ucasal);
    cursor: pointer;
  }

  .flecha:hover {
    border-color: var(--azul-ucasal);
    background: var(--azul-ucasal);
    color: white;
  }

  .flecha svg {
    width: 1.25rem;
  }

  .puntos {
    display: flex;
    align-items: center;
  }

  .punto {
    display: grid;
    width: 2rem;
    height: 2.5rem;
    place-items: center;
    cursor: pointer;
  }

  .punto::after {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #94a3b8;
    transition: width 0.2s, background 0.2s;
  }

  .punto[aria-current="true"]::after {
    width: 1.25rem;
    background: var(--rojo-ucasal);
  }

  .contador {
    min-width: 3rem;
    color: #475569;
    font-size: 0.875rem;
    font-weight: 700;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .punto::after {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-beneficios-especificos]").forEach((carrusel) => {
    const pista = carrusel.querySelector<HTMLElement>("[data-pista]");
    const puntos = Array.from(carrusel.querySelectorAll<HTMLButtonElement>("[data-punto]"));
    const contador = carrusel.querySelector<HTMLElement>("[data-contador]");
    if (!pista || puntos.length < 2) return;

    let activo = 0;
    const pintar = () => {
      activo = Math.max(0, Math.min(puntos.length - 1, Math.round(pista.scrollLeft / pista.clientWidth)));
      puntos.forEach((punto, index) => punto.setAttribute("aria-current", String(index === activo)));
      if (contador) contador.textContent = `${activo + 1} / ${puntos.length}`;
    };

    const ir = (index: number) => {
      const destino = (index + puntos.length) % puntos.length;
      pista.scrollTo({
        left: destino * pista.clientWidth,
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
      });
    };

    carrusel.querySelector("[data-anterior]")?.addEventListener("click", () => ir(activo - 1));
    carrusel.querySelector("[data-siguiente]")?.addEventListener("click", () => ir(activo + 1));
    puntos.forEach((punto, index) => punto.addEventListener("click", () => ir(index)));
    pista.addEventListener("scroll", pintar, { passive: true });
    pista.addEventListener("keydown", (evento) => {
      if (evento.key !== "ArrowLeft" && evento.key !== "ArrowRight") return;
      evento.preventDefault();
      ir(activo + (evento.key === "ArrowRight" ? 1 : -1));
    });

    pintar();
    carrusel.setAttribute("data-listo", "");
  });
</script>
