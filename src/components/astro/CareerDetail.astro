---
import { getImage } from "astro:assets";
const base = import.meta.env.BASE_URL;
import type { ImageMetadata } from "astro";
import {
  MODO_ONLINE,
  MODO_PRESENCIAL,
  esOnline,
  modosCarrera,
} from "../../config/modalidad";
import { getNombreModalidades, getNombreFacultad } from "../../lib/utils";
import BeneficiosCartas from "./BeneficiosCartas.astro";
import ModalidadesPuerta from "./ModalidadesPuerta.astro";
import Financiacion from "./Financiacion.astro";
import Sedes from "./Sedes.astro";
import Form from "../react/Form.tsx";

type PlanEstudios = { semestre: string; materias: string[] }[];

interface Career {
  codcar: number;
  slug: string;
  nombre: string;
  descripcion: string;
  duracion: string;
  modalidad: number[];
  sector: number;
  cio?: { materias: string[] };
  perfilEgresado?: { items: string[] };
  planEstudios?: PlanEstudios;
  planEstudiosPorModalidad?: {
    1?: PlanEstudios;
    7?: PlanEstudios;
  };
}

interface Props {
  carrera: Career;
}

const { carrera } = Astro.props;

const imagenes = import.meta.glob<ImageMetadata>(
  "../../assets/{encabezados,cards}/*.{webp,jpg,jpeg,png}",
  {
    eager: true,
    import: "default",
  },
);

const buscarImagen = (ruta: string) =>
  Object.entries(imagenes).find(([archivo]) => archivo.endsWith(ruta))?.[1];

const fotoDesktop = buscarImagen(`encabezados/${carrera.codcar}-desktop.webp`);
const fotoMobile = buscarImagen(`encabezados/${carrera.codcar}-mobile.webp`);

const imagenRespaldo = buscarImagen(`/cards/${carrera.codcar}.webp`);

const encabezadoDesktop = fotoDesktop ?? imagenRespaldo;
const encabezadoMobile = fotoMobile ?? imagenRespaldo;

if (!encabezadoDesktop || !encabezadoMobile) {
  throw new Error("No se encontraron las imágenes de encabezado");
}

const [
  encabezadoAvifDesktop,
  encabezadoAvifMobile,
  encabezadoWebpDesktop,
  encabezadoWebpMobile,
] = await Promise.all([
  getImage({
    src: encabezadoDesktop,
    format: "avif",
    widths: [1024, 1440, 1920],
  }),
  getImage({
    src: encabezadoMobile,
    format: "avif",
    widths: [640, 828, 1236],
  }),
  getImage({
    src: encabezadoDesktop,
    format: "webp",
    widths: [1024, 1440, 1920],
  }),
  getImage({
    src: encabezadoMobile,
    format: "webp",
    widths: [640, 828, 1236],
  }),
]);

const modalidad = getNombreModalidades(carrera.modalidad);
const facultad = getNombreFacultad(carrera.sector);
const planesPorModalidad = carrera.planEstudiosPorModalidad;
const modoActivo = esOnline ? MODO_ONLINE : MODO_PRESENCIAL;
const planEstudios =
  planesPorModalidad?.[modoActivo] ??
  carrera.planEstudios ??
  planesPorModalidad?.[MODO_PRESENCIAL] ??
  planesPorModalidad?.[MODO_ONLINE];

// Cómo se cursa ESTA carrera en ESTA landing. `carrera.modalidad` ya viene
// recortado a los modos del build (ver src/data/carrerasLanding.ts), así que
// alcanza con mirarlo para saber si es presencial, online o las dos.
const cursaPresencial = carrera.modalidad.includes(MODO_PRESENCIAL);
const cursaOnline = carrera.modalidad.includes(MODO_ONLINE);
const mixta = cursaPresencial && cursaOnline;
const parrafos = carrera.descripcion.split("\\n").filter(Boolean);
---

<main data-scroll-libre>
  <!-- ──────────────────────────── Encabezado ───────────────────────────── -->
  <section
    class="seccion-snap-hero relative isolate flex w-full text-white"
    aria-labelledby="carrera-titulo"
  >
    <div class="absolute inset-0 -z-10">
      <!-- `srcSet.attribute` y no `.src`: con `.src` el `srcset` sale con una
           sola URL y todos los anchos que pide `getImage` más arriba quedan sin
           usar, así que un celular se bajaba la misma imagen que un desktop. Con
           el srcset completo + `sizes` el navegador elige por viewport y DPR.
           El fondo tapa toda la sección, de ahí el `100vw`. -->
      <picture>
        <source
          media="(min-width: 769px)"
          srcset={encabezadoAvifDesktop.srcSet.attribute}
          sizes="100vw"
          type="image/avif"
        />
        <source
          media="(min-width: 769px)"
          srcset={encabezadoWebpDesktop.srcSet.attribute}
          sizes="100vw"
          type="image/webp"
        />
        <source
          srcset={encabezadoAvifMobile.srcSet.attribute}
          sizes="100vw"
          type="image/avif"
        />
        <source
          srcset={encabezadoWebpMobile.srcSet.attribute}
          sizes="100vw"
          type="image/webp"
        />
        <!-- El respaldo apunta al webp procesado y no al asset original, que
             viaja sin optimizar (112 a 478 KB según la carrera). Es el elemento
             LCP de la página: eager y prioridad alta. -->
        <img
          src={encabezadoWebpDesktop.src}
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </picture>
      <div
        class="absolute inset-0 bg-linear-to-t from-black/85 via-black/45 to-black/35"
      >
      </div>
    </div>

    <!-- Mismo velo de arriba que la home: la navbar transparente tiene que
             leerse sobre cualquier foto. -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-32 bg-linear-to-b from-black/55 to-transparent lg:h-40"
    >
    </div>

    <div
      class="contenedor relative flex h-full w-full flex-col justify-end pb-16 pt-28 md:pb-24"
    >
      <p
        class="hero-entra hero-entra-1 mt-8 text-xs font-bold uppercase tracking-[0.2em] text-white/80"
      >
        {facultad}
      </p>

      <h1
        id="carrera-titulo"
        class="hero-entra hero-entra-2 mt-3 max-w-4xl uppercase"
      >
        {carrera.nombre}
      </h1>

      <div class="hero-entra hero-entra-3 mt-6 flex flex-wrap gap-3">
        <span class="ficha-hero">Duración: {carrera.duracion}</span>
        <span class="ficha-hero">Título universitario</span>
        <span
          class="ficha-hero ficha-modalidad"
          style={mixta
            ? "background:linear-gradient(90deg,var(--rojo-ucasal) 10%,var(--azul-ucasal) 90%);border-color:transparent"
            : `background:${cursaOnline ? "var(--azul-ucasal)" : "var(--rojo-ucasal)"};border-color:transparent`}
        >
          {modalidad}
        </span>
      </div>

      <div class="hero-entra hero-entra-4 mt-10 flex flex-wrap gap-4">
        <a href="#contacto" class="boton-cta-hero">Pedí información</a>
        {
          planEstudios && (
            <a
              href="#plan-de-estudios"
              class="flex w-fit items-center justify-center rounded-[10px] border border-white/60 px-6 py-3 text-sm font-semibold uppercase text-white transition-colors hover:bg-white/15"
            >
              Ver plan de estudios
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section id="detalle" class="bg-white py-16 md:py-20">
    <div
      class="contenedor grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] 2xl:grid-cols-[minmax(0,1fr)_minmax(0,34rem)] lg:gap-14"
    >
      <div class="min-w-0">
        <h2 class="text-(--azul-dark-ucasal)">Sobre la carrera</h2>
        <div class="mt-5 space-y-4 text-lg leading-8 text-slate-600">
          {parrafos.map((parrafo) => <p>{parrafo}</p>)}
        </div>

        {
          carrera.perfilEgresado && (
            <>
              <h3 class="mt-14 text-(--azul-ucasal)">
                El graduado de {carrera.nombre} podrá
              </h3>
              <ul class="mt-6 grid gap-3 text-slate-600">
                {carrera.perfilEgresado.items.map((item) => (
                  <li class="flex gap-3 leading-7">
                    <span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-full bg-slate-600" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        <!-- ──────────────────────────── Modalidades ────────────────────────────
         Solo las de ESTA carrera, y el CTA manda al formulario de arriba en vez
         de al explorador (que no existe en esta página). -->
        <ModalidadesPuerta
          modosCarrera={carrera.modalidad}
          titulo={mixta
            ? "Elegí cómo cursarla"
            : cursaOnline
              ? "Esta carrera se cursa online"
              : "Esta carrera se cursa en el campus"}
          destinoCta="#contacto"
          textoCta="Consultar por esta modalidad"
          onSubPage={true}
        />
        {
          planEstudios && (
            <div id="plan-de-estudios" class="scroll-mt-24">
              <h2 class="mt-14 text-(--azul-dark-ucasal)">Plan de estudios</h2>
              <div class="mt-6 grid gap-4 md:grid-cols-2">
                {planEstudios.map((anio) => (
                  <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <h3 class="text-lg font-bold text-(--rojo-ucasal)">
                      {anio.semestre}
                    </h3>
                    <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-600">
                      {anio.materias.map((materia) => (
                        <li class="flex gap-2">
                          <span class="text-slate-400">•</span>
                          <span>{materia}</span>
                        </li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </div>
          )
        }
      </div>
      <aside
        id="contacto"
        class="order-first min-w-0 scroll-mt-24 lg:order-0 lg:sticky lg:top-24"
      >
        <Form
          codcarInicial={String(carrera.codcar)}
          onSubPage={true}
          modosDisponibles={modosCarrera}
          client:visible
        />
      </aside>
    </div>
    {
      carrera.codcar === 84 ||
      carrera.codcar === 19 ||
      carrera.codcar === 105 ||
      carrera.codcar === 26 ? (
        <section class="flex flex-row gap-16 relative contenedor py-12">
          <div class="text-xl flex flex-col justify-center items-center text-center">
            <p class="text-white bg-(--rojo-ucasal) rounded-full size-8 flex justify-center items-center">
              !
            </p>
            <p class="flex flex-col">
              <span class="first-letter:text-(--rojo-ucasal)">Curso de</span>
              <span class="first-letter:text-(--rojo-ucasal)">Ingreso</span>
              <span class="first-letter:text-(--rojo-ucasal)">Obligatorio</span>
            </p>
          </div>
          <div class="text-lg">
            El <span class="font-bold">curso de ingreso obligatorio (CIO)</span>{" "}
            tiene por objetivo preparar a los estudiantes para una experiencia
            universitaria exitosa y productiva. <br />
            El CIO de {carrera.nombre} consta de los siguientes módulos:
            {carrera.cio && (
              <>
                <ul class="list-disc py-2 italic mx-8">
                  {carrera.cio?.materias.map((modulo) => (
                    <li>{modulo}</li>
                  ))}
                </ul>
              </>
            )}
            Se realizará durante el mes de Febrero y es condición necesaria para
            el ingreso a la carrera cumplir con:
            <ul class="list-disc mx-8 py-2">
              <li>Contar con almenos el 80% de asistencia.</li>
              <li>Superar las instancias evaluativas que se darán durante el mes de cursado.</li>
              <li>Pago del arancel del curso introductorio obligatorio.</li>
            </ul>
              El curso podrá cursarse en diferentes turnos, sujeto a la cantidad de aspirantes y comisiones que se habiliten.
          </div>
        </section>
      ) : (
        ""
      )
    }
  </section>

  <!-- ───────────────────────────── Beneficios ──────────────────────────── -->
  <div class="relative isolate">
    <div class="absolute inset-0 -z-10">
      <picture>
        <source media="(min-width: 769px)" srcset={`${base}fondos/azul.webp`} />
        <img
          src={`${base}fondos/azul.webp`}
          alt=""
          class="sticky top-0 h-dvh w-full object-cover"
        />
      </picture>
    </div>
    <BeneficiosCartas base={base} />
    <div class="contenedor grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="min-w-0 text-white">
        <h2 style="color:white;">Estudiar es más fácil de lo que creés</h2>
        <p class="mt-5 max-w-[45ch] text-lg leading-8 text-white/85">
          {carrera.nombre} tiene planes de pago, becas y descuentos por convenio.
          Consultá los aranceles vigentes y financiá la cuota con tu tarjeta.
        </p>
        <a href="#contacto" class="boton-cta-hero mt-8 inline-flex"
          >Quiero que me contacten</a
        >
      </div>
      <div class="min-w-0">
        <Financiacion disposicion="columna" />
      </div>
    </div>
  </div>

  <!-- ────────────────────────── Campus / Sedes ─────────────────────────── -->
  <Sedes />
</main>

<style>
  .ficha-hero {
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.35);
    background: rgb(255 255 255 / 0.12);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    backdrop-filter: blur(4px);
  }

  .ficha-modalidad {
    text-transform: capitalize;
  }
</style>
