---
import { getNombreModalidades, getNombreFacultad } from "../../lib/utils";

interface Career {
    nombre: string;
    descripcion: string;
    duracion: string;
    modalidad: number[];
    sector: number;
    perfilEgresado?: { items: string[] };
    planEstudios?: { semestre: string; materias: string[] }[];
}

interface Props {
    carrera: Career;
}
const { carrera } = Astro.props;
const modalidad = getNombreModalidades(carrera.modalidad);
const facultad = getNombreFacultad(carrera.sector);
---

<main>
    <section class="bg-(--azul-dark-ucasal) py-16 text-white">
        <div class="contenedor">
            <a
                href={`${import.meta.env.BASE_URL}#carreras`}
                class="text-sm font-semibold text-white/70 hover:text-white"
                >← Volver a carreras</a
            ><p
                class="mt-8 text-sm font-bold uppercase tracking-[0.2em] text-(--rojo-ucasal)"
            >
                Carrera universitaria
            </p><h1
                class="mt-3 max-w-4xl text-4xl font-black leading-tight sm:text-6xl"
            >
                {carrera.nombre}
            </h1><p class="mt-3 text-sm font-semibold uppercase tracking-wide text-white/60">{facultad}</p><div class="mt-7 flex flex-wrap gap-3">
                <span class="rounded-full bg-white/10 px-4 py-2 text-sm">Duración: {carrera.duracion}</span>
                <span class="rounded-full bg-white/10 px-4 py-2 text-sm">Modalidad: {modalidad}</span>
            </div>
        </div>
    </section>
    <section
        class="contenedor mx-auto grid gap-12 py-16 lg:grid-cols-[1fr_0.7fr]"
    >
        <div>
            <h2 class="text-3xl font-black text-(--azul-dark-ucasal)">
                Sobre la carrera
            </h2><div class="mt-5 space-y-4 text-lg leading-8 text-slate-600">
                {
                    carrera.descripcion
                        .split("\\n")
                        .map((paragraph) => <p>{paragraph}</p>)
                }
            </div>{
                carrera.perfilEgresado && (
                    <>
                        <>
                            <h2 class="mt-12 text-3xl font-black text-(--azul-dark-ucasal)">
                                Perfil del egresado
                            </h2>
                            <ul class="mt-5 grid gap-3 text-slate-600">
                                {carrera.perfilEgresado.items.map((item) => (
                                    <li class="flex gap-3">
                                        <span class="font-bold text-(--rojo-ucasal)">
                                            ✓
                                        </span>
                                        <span>{item}</span>
                                    </li>
                                ))}
                            </ul>
                        </>
                    </>
                )
            }
        </div><aside
            id="contacto"
            class="h-fit rounded-3xl bg-slate-50 p-7 shadow-sm"
        >
            <h2 class="text-2xl font-black text-(--azul-dark-ucasal)">
                ¿Querés saber más?
            </h2><p class="mt-3 leading-7 text-slate-600">
                Recibí información sobre esta carrera y los próximos pasos para
                ingresar.
            </p><a
                href="https://www.ucasal.edu.ar/inscripciones/?utm_source=landing_primer_ingreso"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex w-full justify-center rounded-xl bg-(--rojo-ucasal) px-5 py-3 font-bold text-white hover:bg-(--rojo-dark-ucasal)"
                >Quiero información</a
            >
        </aside>
    </section>
    {
        carrera.planEstudios && (
            <section class="bg-slate-50 py-16">
                <div class="contenedor">
                    <>
                        <h2 class="text-3xl font-black text-(--azul-dark-ucasal)">
                            Plan de estudios
                        </h2>
                        <div class="mt-8 grid gap-4 md:grid-cols-2">
                            {carrera.planEstudios.map((year) => (
                                <article class="rounded-2xl border border-slate-200 bg-white p-6">
                                    <h3 class="font-bold text-(--rojo-ucasal)">
                                        {year.semestre}
                                    </h3>
                                    <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-600">
                                        {year.materias.map((subject) => (
                                            <li>• {subject}</li>
                                        ))}
                                    </ul>
                                </article>
                            ))}
                        </div>
                    </>
                </div>
            </section>
        )
    }
</main>
