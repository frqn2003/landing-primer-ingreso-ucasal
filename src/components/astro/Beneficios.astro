---
const beneficios = {
  beneficios_presencial: [
    {
      codigo: "becas",
      id: 1,
      titulo: "Becas y ayudas económicas",
      descripcion: "",
    },
    {
      codigo: "validez",
      id: 2,
      titulo: "Título con validez nacional",
      descripcion: "",
    },
    {
      codigo: "campus",
      id: 3,
      titulo: "Campus en Castañares",
      descripcion: "",
    },
    {
      codigo: "edificios-nuevos",
      id: 4,
      titulo: "Edificios nuevos y modernos",
      descripcion: "",
    },
    {
      codigo: "biblioteca",
      id: 5,
      titulo: "Biblioteca y biblioteca digital",
      descripcion: "",
    },
    {
      codigo: "deportes",
      id: 6,
      titulo: "Deportes y actividades recreativas",
      descripcion: "",
    },
    {
      codigo: "practicas",
      id: 7,
      titulo: "Prácticas profesionales",
      descripcion: "",
    },
    {
      codigo: "pasantias",
      id: 8,
      titulo: "Pasantías, intercambios y bolsa de trabajo",
      descripcion: "",
    },
  ],
  beneficios_virtual: [
    {
      codigo: "virtual",
      id: 1,
      titulo: "Título 1",
      descripcion: "Descripción 1",
    },
  ],
};
---

<section id="beneficios" class="bg-white py-10">
  <div class="contenedor">
    <h2>Los beneficios de estudiar en UCASAL</h2>
    <div class="flex flex-row gap-4">
      <div
        class="my-4 w-0.5 shrink-0 self-stretch bg-linear-to-b from-(--azul-ucasal) to-(--rojo-ucasal)"
        aria-hidden="true"
      />

      <ol class="grid w-full grid-cols-1 md:grid-cols-2">
        {
          beneficios.beneficios_presencial.map((beneficio, index) => (
            <li class="relative my-4 border-gray-500 px-4 md:even:border-l-2">
              <span
                class:list={[
                  "absolute -left-6 top-0 z-10 size-4 rounded-full border-4 border-white bg-(--azul-ucasal)",
                  index % 2 === 0 ? "block" : "md:hidden",
                ]}
                aria-hidden="true"
              />

              <h4 class="text-xl font-bold">{beneficio.titulo}</h4>
              <p>{beneficio.descripcion}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
