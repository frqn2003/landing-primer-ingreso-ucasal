---
import Form from "../react/Form.tsx";
import { modosCarrera } from "../../config/modalidad";
import carrerasLanding from "../../data/carrerasLanding";
import { paraFormulario } from "../../data/carrerasCliente";
import Financiacion from "./Financiacion.astro";

// El catálogo se recorta acá, en el servidor: el formulario solo necesita
// codcar, nombre, modalidad y sector para armar el desplegable. Ver
// src/data/carrerasCliente.ts.
const carreras = paraFormulario(carrerasLanding);
---

<!-- min-h-dvh y no h-dvh: el formulario y las formas de pago son más altos
     que la pantalla en mobile, y con alto fijo el sobrante (+455px) se dibujaba
     encima de Testimonios. Está en la zona de scroll libre, así que puede crecer. -->
<section id="contacto" class="flex justify-center items-center relative min-h-dvh py-16" aria-labelledby="contacto-titulo">
    <div
        class="contenedor grid w-full h-full justify-center items-center gap-10 lg:grid-cols-[1fr_minmax(0,42rem)] lg:gap-14 relative z-20"
    >
        <div class="min-w-0 flex justify-center items-center">
            <Financiacion />
        </div>

        <div class="mx-2 min-w-0 h-full flex justify-center items-center">
            <Form
                carreras={carreras}
                onSubPage={false}
                modosDisponibles={modosCarrera}
                client:visible
            />
        </div>
    </div>
</section>
