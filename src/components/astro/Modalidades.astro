---
import carreras from '../../data/carreras';

const colorVar = { rojo: 'var(--rojo-ucasal)', azul: 'var(--azul-ucasal)' };

const planesBase = [
    {
        code: 1,
        nombre: 'Presencial',
        color: 'rojo',
        descripcion: 'La experiencia universitaria completa',
        checklist: [
            { texto: 'Clases presenciales en nuestras sedes', color: 'rojo' },
            { texto: 'Vida y comunidad universitaria', color: 'rojo' },
        ],
        cta: 'Ver carreras presenciales',
    },
    {
        code: 7,
        nombre: 'Online',
        color: 'azul',
        descripcion: 'Para quienes necesitan flexibilidad total',
        checklist: [
            { texto: 'Cursada 100% a distancia', color: 'azul' },
            { texto: 'Acompañamiento docente', color: 'azul' },
            { texto: 'Recursos y materiales digitales', color: 'azul' },
        ],
        cta: 'Ver carreras online',
    },
    {
        code: 2,
        nombre: 'Híbrida',
        color: 'mixto',
        descripcion: 'Lo mejor de ambos mundos',
        checklist: [
            { texto: 'Combina encuentros presenciales y virtuales', color: 'azul' },
            { texto: 'Lo mejor de ambas experiencias', color: 'rojo' },
        ],
        cta: 'Ver carreras híbridas',
    },
];

const planes = planesBase.map((plan) => ({
    ...plan,
    cantidad: carreras.filter((c) => c.modalidad.includes(plan.code)).length,
}));
---

<section id="modalidades" class="bg-slate-50 py-20">
    <div class="contenedor mx-auto max-w-7xl">
        <div class="max-w-2xl">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-(--rojo-ucasal)">Elegí tu modalidad</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-(--azul-dark-ucasal) sm:text-4xl">Estudiá de la forma que mejor se adapta a tu vida</h2>
        </div>

        <div class="relative mt-10 overflow-hidden">
            <div id="modalidades-track" class="relative mx-auto h-[440px] max-w-[900px]">
                {planes.map((plan, i) => (
                    <article
                        class="modalidad-card absolute top-1/2 left-1/2 w-[250px] rounded-3xl border-2 border-slate-200 bg-white p-7 shadow-lg sm:w-[320px]"
                        data-index={i}
                        data-code={plan.code}
                        data-color={plan.color}
                    >
                        <h3 class="text-2xl font-bold text-(--azul-dark-ucasal)">{plan.nombre}</h3>
                        <p class="mt-2 text-sm text-slate-500">{plan.descripcion}</p>
                        <ul class="mt-5 flex flex-col gap-2.5 text-sm text-slate-600">
                            {plan.checklist.map((item) => (
                                <li class="flex gap-2">
                                    <span class="font-bold" style={`color:${colorVar[item.color]}`}>✓</span>
                                    {item.texto}
                                </li>
                            ))}
                        </ul>
                        <p class="mt-6 text-xs font-bold uppercase tracking-wide text-slate-400">
                            {plan.cantidad} {plan.cantidad === 1 ? 'carrera disponible' : 'carreras disponibles'}
                        </p>
                        <a href="#carreras" class="modalidad-cta mt-3 block rounded-xl border-2 py-3 text-center font-bold transition-colors">{plan.cta}</a>
                    </article>
                ))}
            </div>
        </div>

        <div class="mt-6 flex justify-center gap-2">
            {planes.map((plan, i) => (
                <button
                    type="button"
                    class="modalidad-dot h-2.5 w-2.5 rounded-full bg-slate-300 transition-colors"
                    data-index={i}
                    data-color={plan.color}
                    aria-label={`Ir a ${plan.nombre}`}
                ></button>
            ))}
        </div>
    </div>
</section>

<style>
    .modalidad-card {
        transition: transform 0.5s ease, opacity 0.5s ease, box-shadow 0.5s ease, border-color 0.5s ease;
    }
    .modalidad-card[data-estado='izquierda'] {
        transform: translate(-155%, -50%) scale(0.82);
        opacity: 0.5;
        z-index: 20;
        pointer-events: auto;
        cursor: pointer;
    }
    .modalidad-card[data-estado='derecha'] {
        transform: translate(55%, -50%) scale(0.82);
        opacity: 0.5;
        z-index: 20;
        pointer-events: auto;
        cursor: pointer;
    }
    .modalidad-card[data-estado='activa'] {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
        z-index: 30;
        pointer-events: auto;
        cursor: default;
    }
    .modalidad-card[data-estado='activa'][data-color='rojo'] {
        border-color: var(--rojo-ucasal);
        box-shadow: 0 20px 45px rgba(216, 49, 53, 0.2);
    }
    .modalidad-card[data-estado='activa'][data-color='azul'] {
        border-color: var(--azul-ucasal);
        box-shadow: 0 20px 45px rgba(28, 77, 134, 0.2);
    }
    .modalidad-card[data-estado='activa'][data-color='mixto'] {
        border-color: transparent;
        background-image: linear-gradient(#fff, #fff), linear-gradient(90deg, var(--azul-ucasal) 50%, var(--rojo-ucasal) 50%);
        background-origin: border-box;
        background-clip: padding-box, border-box;
        box-shadow: 0 20px 45px rgba(90, 60, 100, 0.18);
    }

    /* Los botones de las tarjetas de fondo no son cliqueables, solo sirven las tarjetas para seleccionarlas */
    .modalidad-card:not([data-estado='activa']) .modalidad-cta {
        pointer-events: none;
    }

    .modalidad-cta {
        border-color: var(--azul-ucasal);
        color: var(--azul-ucasal);
    }
    .modalidad-card[data-estado='activa'][data-color='rojo'] .modalidad-cta {
        background: var(--rojo-ucasal);
        border-color: var(--rojo-ucasal);
        color: #fff;
    }
    .modalidad-card[data-estado='activa'][data-color='azul'] .modalidad-cta {
        background: var(--azul-ucasal);
        border-color: var(--azul-ucasal);
        color: #fff;
    }
    .modalidad-card[data-estado='activa'][data-color='mixto'] .modalidad-cta {
        background: linear-gradient(90deg, var(--azul-ucasal) 50%, var(--rojo-ucasal) 50%);
        border-color: transparent;
        color: #fff;
    }

    .modalidad-dot.activo[data-color='rojo'] { background: var(--rojo-ucasal); }
    .modalidad-dot.activo[data-color='azul'] { background: var(--azul-ucasal); }
    .modalidad-dot.activo[data-color='mixto'] { background: linear-gradient(90deg, var(--azul-ucasal) 50%, var(--rojo-ucasal) 50%); }
    .modalidad-dot.activo {
        width: 1.5rem;
        border-radius: 9999px;
    }
</style>

<script is:inline>
    const tarjetas = Array.from(document.querySelectorAll('.modalidad-card'));
    const puntos = Array.from(document.querySelectorAll('.modalidad-dot'));
    const total = tarjetas.length;
    let activa = 0;

    function actualizar() {
        tarjetas.forEach((tarjeta, i) => {
            const diff = (((i - activa) % total) + total) % total;
            const estado = diff === 0 ? 'activa' : diff === 1 ? 'derecha' : 'izquierda';
            tarjeta.dataset.estado = estado;
        });
        puntos.forEach((punto, i) => punto.classList.toggle('activo', i === activa));
    }

    function irA(indice) {
        activa = ((indice % total) + total) % total;
        actualizar();
    }

    tarjetas.forEach((tarjeta, i) => tarjeta.addEventListener('click', () => irA(i)));
    puntos.forEach((punto, i) => punto.addEventListener('click', () => irA(i)));

    /* El CTA de la tarjeta activa aplica el filtro de modalidad correspondiente en "Encontrá tu carrera" */
    tarjetas.forEach((tarjeta) => {
        const cta = tarjeta.querySelector('.modalidad-cta');
        cta?.addEventListener('click', (e) => {
            if (tarjeta.dataset.estado !== 'activa') {
                e.preventDefault();
                return;
            }
            const codigo = Number(tarjeta.dataset.code);
            window.dispatchEvent(new CustomEvent('preselect-modalidad', { detail: { code: codigo } }));
        });
    });

    actualizar();
</script>
