---
import data from "../../data/carreras";
import { sanitizarTexto } from "../../lib/utils";

interface Props {
  onSubPage?: boolean;
}
const { onSubPage } = Astro.props;

// Equivalente a useParams()
const { slug } = Astro.params;
const slugLimpio = slug ? sanitizarTexto(slug) : "";
const carreraActiva = data.find((c: any) => c.slug === slugLimpio);
const carrerasConCCC =
  carreraActiva?.codcar === 401 || carreraActiva?.codcar === 196;
const urlInscripcion = carrerasConCCC
  ? "https://www.ucasal.edu.ar/carreras/ccc-form.php"
  : "https://www.ucasal.edu.ar/inscripciones/?utm_source=landing_agosto";

const base = import.meta.env.BASE_URL;

// Solo en la Home la navbar flota transparente dentro del hero; en subpáginas mantiene el comportamiento sólido de siempre.
const flotarSobreHero = !onSubPage;
---

<nav
  id="navbar"
  role="navigation"
  data-flotar={flotarSobreHero ? "true" : "false"}
  data-tema={flotarSobreHero ? "transparente" : "solido"}
  class={flotarSobreHero
    ? "w-full z-50 fixed top-0 transition-all duration-500 ease-in-out"
    : "w-full z-50 top-0 transition-all duration-500 ease-in-out bg-white/80 relative md:backdrop-blur-md"}
>
  <div
    class="px-4 mx-auto py-3 grid grid-cols-2 lg:grid-cols-3 items-center justify-between h-18 z-50"
    id="navbar-inner"
  >
    <div class="justify-start flex items-center" id="logo-container">
      <!-- Estado "Volver al inicio" -->
      <a
        href={base}
        class="flex items-center gap-2 text-sm font-semibold text-(--azul-ucasal) hover:text-(--rojo-ucasal) transition-colors text-center"
        id="volver-inicio-link"
        style="display:none"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        <div
          class="flex justify-items-center gap-2"
          id="volver-inicio-scrolled"
          style="display:none"
        >
          <img
            src={`${import.meta.env.BASE_URL}iso.svg`}
            alt="UCASAL"
            class="h-6 w-auto"
          />
          <span class="flex items-center text-center">Volver al inicio</span>
        </div>
        <span id="volver-inicio-texto">Volver al inicio</span>
      </a>

      <!-- Estado normal: logo -->
      <a
        href="#"
        id="logo-normal"
        class="text-3xl font-sans font-semibold text-(--azul-light-ucasal)"
        style="display:none"
      >
        <img
          src={`${import.meta.env.BASE_URL}ucasal-color-h.svg`}
          alt="Logo"
          class="h-10 w-auto"
        />
      </a>
      <img
        src={`${import.meta.env.BASE_URL}iso.svg`}
        alt="Logo"
        class="h-10 w-auto"
        id="logo-iso"
      />
    </div>

    <section
      class="hidden lg:flex items-center justify-center space-x-1 lg:space-x-2"
    >
      {
        onSubPage ? (
          <>
            <button data-scroll-to="modalidades" class="nav-link">
              Modalidades
            </button>
            <button data-scroll-to="beneficios" class="nav-link">
              Beneficios
            </button>
          </>
        ) : (
          <>
            <button data-scroll-to="beneficios" class="nav-link">
              Beneficios
            </button>
            <button data-scroll-to="modalidades" class="nav-link">
              Modalidades
            </button>
            <button data-scroll-to="carreras" class="nav-link">
              Carreras
            </button>
          </>
        )
      }
      <button data-scroll-to="sedes" class="nav-link">Sedes</button>
    </section>

    <div class="justify-end flex items-center">
      <a
        href={urlInscripcion}
        target="_blank"
        rel="noopener noreferrer"
        id="boton-inscripcion"
        class="hidden lg:flex boton-inscripcion"
      >
        <span id="iconoInscripcion">📉</span>
        ¡Quiero Inscribirme!
      </a>
      <button
        type="button"
        id="menu-button"
        class="inline-flex lg:hidden items-center justify-center size-10 p-2 text-sm text-gray-500 hover:bg-gray-100"
        aria-label="Abrir menú"
      >
        <svg
          id="icon-abrir"
          class="w-4 h-4"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"></path>
        </svg>
        <svg
          id="icon-cerrar"
          class="w-4 h-4 hidden"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 14 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1l12 12M13 1L1 13"></path>
        </svg>
      </button>
    </div>
  </div>

  <section
    id="navMenu"
    class="backdrop-blur-md shadow-lg overflow-hidden absolute w-full transition-all duration-300 ease-out z-50 opacity-0 -translate-y-4 max-h-0 invisible"
  >
    <ul class="flex flex-col gap-2 w-full">
      {
        onSubPage ? (
          <>
            <li class="w-full">
              <button
                data-scroll-to="modalidades"
                class="mobile-nav-link justify-start items-start flex w-full px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-(--rojo-ucasal) transition-colors font-semibold border-l-4 border-transparent hover:border-(--rojo-ucasal)"
              >
                Modalidades
              </button>
            </li>
            <li class="w-full">
              <button
                data-scroll-to="beneficios"
                class="mobile-nav-link justify-start items-start flex w-full px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-(--rojo-ucasal) transition-colors font-semibold border-l-4 border-transparent hover:border-(--rojo-ucasal)"
              >
                Beneficios
              </button>
            </li>
          </>
        ) : (
          <>
            <li class="w-full">
              <button
                data-scroll-to="beneficios"
                class="mobile-nav-link justify-start items-start flex w-full px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-(--rojo-ucasal) transition-colors font-semibold border-l-4 border-transparent hover:border-(--rojo-ucasal)"
              >
                Beneficios
              </button>
            </li>
            <li class="w-full">
              <button
                data-scroll-to="modalidades"
                class="mobile-nav-link justify-start items-start flex w-full px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-(--rojo-ucasal) transition-colors font-semibold border-l-4 border-transparent hover:border-(--rojo-ucasal)"
              >
                Modalidades
              </button>
            </li>
            <li class="w-full">
              <button
                data-scroll-to="carreras"
                class="mobile-nav-link justify-start items-start flex w-full px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-(--rojo-ucasal) transition-colors font-semibold border-l-4 border-transparent hover:border-(--rojo-ucasal)"
              >
                Carreras
              </button>
            </li>
          </>
        )
      }
      <li class="w-full">
        <button
          data-scroll-to="sedes"
          class="mobile-nav-link justify-start items-start flex w-full px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-(--rojo-ucasal) transition-colors font-semibold border-l-4 border-transparent hover:border-(--rojo-ucasal)"
          >Sedes</button
        >
      </li>
      <li class="py-2 border-t border-gray-200 w-full">
        <button
          id="mobile-inscribirme"
          class="mobile-nav-link justify-start items-start flex w-full px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-(--rojo-ucasal) transition-colors font-semibold border-l-4 border-transparent hover:border-(--rojo-ucasal)"
          >¡Quiero Inscribirme!</button
        >
      </li>
    </ul>
  </section>
  <div
    id="overlay"
    class="fixed z-10 hidden w-full h-dvh bg-gray-700/40 backdrop-blur-sm"
  >
  </div>
</nav>

<style>
  /* Navbar flotando transparente sobre el hero de la Home, hasta que se hace scroll */
  #navbar[data-tema="transparente"] .nav-link {
    color: #fff;
  }
  #navbar[data-tema="transparente"] .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }
  #navbar[data-tema="transparente"] .nav-link.active {
    color: #fff;
    background-color: rgba(255, 255, 255, 0.2);
  }
  #navbar[data-tema="transparente"] #menu-button {
    color: #fff;
  }
</style>

<script
  is:inline
  define:vars={{ urlInscripcion, onSubPage: !!onSubPage, flotarSobreHero }}
>
  const nav = document.getElementById("navbar");
  const navInner = document.getElementById("navbar-inner");
  const menuButton = document.getElementById("menu-button");
  const navMenu = document.getElementById("navMenu");
  const overlay = document.getElementById("overlay");
  const iconAbrir = document.getElementById("icon-abrir");
  const iconCerrar = document.getElementById("icon-cerrar");
  const botonInscripcion = document.getElementById("boton-inscripcion");
  const iconoInscripcion = document.getElementById("iconoInscripcion");
  const secciones = ["beneficios", "carreras", "modalidades", "sedes"];

  const logoIso = document.getElementById("logo-iso");
  const logoNormal = document.getElementById("logo-normal");
  const volverInicioLink = document.getElementById("volver-inicio-link");
  const volverInicioScrolled = document.getElementById(
    "volver-inicio-scrolled",
  );
  const volverInicioTexto = document.getElementById("volver-inicio-texto");

  // "Volver al inicio" se muestra solo si se entró a esta página desde la Home
  // (link con ?from=landing). Se guarda en sessionStorage para sobrevivir un F5.
  // Al volver a estar en la Home (onSubPage=false) se limpia esa marca, para que
  // no quede "pegada" si luego se entra directo a otra carrera.
  let fromLanding = false;
  if (onSubPage) {
    const url = new URL(window.location.href);
    const vieneDeLandingPorURL = url.searchParams.get("from") === "landing";
    if (vieneDeLandingPorURL) {
      sessionStorage.setItem("fromLanding", "true");
      url.searchParams.delete("from");
      history.replaceState({}, "", url);
    }
    fromLanding =
      vieneDeLandingPorURL || sessionStorage.getItem("fromLanding") === "true";
  } else {
    sessionStorage.removeItem("fromLanding");
  }

  let menuAbierto = false;

  function toggleMenu(forzar) {
    menuAbierto = forzar ?? !menuAbierto;
    navMenu.classList.toggle("opacity-100", menuAbierto);
    navMenu.classList.toggle("bg-white", menuAbierto);
    navMenu.classList.toggle("translate-y-0", menuAbierto);
    navMenu.classList.toggle("max-h-96", menuAbierto);
    navMenu.classList.toggle("visible", menuAbierto);
    navMenu.classList.toggle("opacity-0", !menuAbierto);
    navMenu.classList.toggle("-translate-y-4", !menuAbierto);
    navMenu.classList.toggle("max-h-0", !menuAbierto);
    navMenu.classList.toggle("invisible", !menuAbierto);
    overlay.classList.toggle("hidden", !menuAbierto);
    iconAbrir.classList.toggle("hidden", menuAbierto);
    iconCerrar.classList.toggle("hidden", !menuAbierto);
    menuButton.setAttribute(
      "aria-label",
      menuAbierto ? "Cerrar menú" : "Abrir menú",
    );
  }

  menuButton.addEventListener("click", () => toggleMenu());
  overlay.addEventListener("click", () => toggleMenu(false));

  document.addEventListener("mousedown", (e) => {
    if (
      menuAbierto &&
      !navMenu.contains(e.target) &&
      !menuButton.contains(e.target)
    ) {
      toggleMenu(false);
    }
  });

  document
    .getElementById("mobile-inscribirme")
    ?.addEventListener("click", () => {
      toggleMenu(false);
      window.open(urlInscripcion, "_blank", "noopener,noreferrer");
    });

  document.querySelectorAll("[data-scroll-to]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-scroll-to");
      document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
    });
  });

  function handleScroll() {
    if (menuAbierto) toggleMenu(false);

    const scrolled = window.scrollY > 150;

    if (flotarSobreHero) {
      nav.classList.toggle("bg-white/80", scrolled);
      nav.classList.toggle("md:backdrop-blur-md", scrolled);
      nav.classList.toggle("shadow-sm", scrolled);
      botonInscripcion.classList.toggle("boton-cta", scrolled);
      botonInscripcion.classList.toggle("boton-inscripcion", !scrolled);
      iconoInscripcion.style.display = scrolled ? "none" : "flex";
      nav.dataset.tema = scrolled ? "solido" : "transparente";
    } else {
      nav.classList.toggle("sticky", scrolled);
      nav.classList.toggle("nav-menu", scrolled);
      nav.classList.toggle("relative", !scrolled);
    }
    navInner.classList.toggle("contenedor", scrolled);

    /* Actualizar logo */

    if (fromLanding) {
      logoIso.style.display = "none";
      logoNormal.style.display = "none";
      volverInicioLink.style.display = "flex";
      volverInicioScrolled.style.display = scrolled ? "flex" : "none";
      volverInicioTexto.style.display = scrolled ? "none" : "inline";
    } else {
      volverInicioLink.style.display = "none";
      logoIso.style.display = scrolled ? "none" : "block";
      logoNormal.style.display = scrolled ? "block" : "none";
    }
    let activa = "";
    if (scrolled) {
      const centro = window.innerHeight / 2;
      for (const id of secciones) {
        const el = document.getElementById(id);
        if (!el) continue;
        const rect = el.getBoundingClientRect();
        if (rect.top <= centro && rect.bottom >= centro) {
          activa = id;
          break;
        }
      }
    }
    document.querySelectorAll("[data-scroll-to]").forEach((btn) => {
      btn.classList.toggle(
        "active",
        btn.getAttribute("data-scroll-to") === activa,
      );
    });
  }

  window.addEventListener("scroll", handleScroll, { passive: true });
</script>
