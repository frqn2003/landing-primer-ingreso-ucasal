---
// Sección de sedes: a la izquierda el recorrido del campus (presencial) o el
// mapa de sedes del país (online), y a la derecha siempre las preguntas
// frecuentes. Qué se embebe lo decide src/config/contenido.ts según el build.
//
// No es `seccion-snap` a propósito: las preguntas se despliegan y cambian de
// alto, y el snap obligatorio no tiene punto intermedio para una sección más
// alta que la pantalla. Va en la zona de scroll libre de index.astro.
import { sedes } from "../../config/contenido";
import Faq from "./Faq.astro";
---

<section id="sedes" class="bg-white py-5 seccion-snap justify-center relative items-center" aria-labelledby="sedes-titulo">
    <div
        class="contenedor grid w-full items-start gap-10 lg:grid-cols-2 lg:gap-14"
    >
        <div class="min-w-0">
            <h2
                id="sedes-titulo"
                class="mt-3 text-2xl font-black text-(--azul-dark-ucasal) sm:text-3xl"
            >
                {sedes.titulo}
            </h2>

            <div
                class="marco-embebido mt-6 h-72 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm md:h-auto"
                style={`--proporcion: ${sedes.proporcion}`}
            >
                <iframe
                    src={sedes.url}
                    title={sedes.tituloEmbebido}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allow="fullscreen; accelerometer; gyroscope; magnetometer; xr-spatial-tracking"
                    allowfullscreen
                    class="size-full border-0"></iframe>
            </div>

        </div>

        <div class="min-w-0">
            <Faq variante="columna" />
        </div>
    </div>
</section>

<style>
    /* La proporción va solo desde md: en mobile el ancho es fijo (325px) y una
       proporción ancha deja el embebido tan bajo que no se entiende. Combinarla
       con min-height no sirve: el navegador satisface la proporción estirando el
       ancho y se desborda el contenedor. */
    @media (min-width: 768px) {
        .marco-embebido {
            aspect-ratio: var(--proporcion);
        }
    }
</style>
