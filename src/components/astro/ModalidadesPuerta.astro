---
import { MODO_HOME, MODO_ONLINE, modosPuerta } from "../../config/modalidad";

interface Props {
  /**
   * Modos de cursado de UNA carrera (los códigos 1 y 7 de `carrera.modalidad`).
   * Si viene, la sección muestra solo las puertas de esa carrera en vez del
   * catálogo completo. Lo usa el detalle de carrera.
   */
  modosCarrera?: number[];
  titulo?: string;
  /**
   * A dónde va el CTA de cada puerta. En la Home al explorador de carreras
   * (que escucha `preselect-modalidad`); en el detalle, al formulario.
   */
  destinoCta?: string;
  textoCta?: string;
}

const {
  modosCarrera,
  titulo = "Modalidades",
  destinoCta = "#carreras",
  textoCta = "Explorar carreras de esta modalidad",
} = Astro.props;

const todasLasModalidades = [
  {
    id: 1,
    codigo: 1,
    color: "--rojo-ucasal",
    nombre: "presencial",
    caracteristicas: [
      "Clases en el campus",
      "Laboratorios y biblioteca",
      "Prácticas Presenciales",
    ],
    description: "Clases en vivo, acceso a laboratorios y biblioteca",
    imagen: "https://www.placehold.co/600x400?text=Presencial",
  },
  {
    id: 2,
    codigo: 7,
    nombre: "virtual",
    color: "--azul-ucasal",
    caracteristicas: [
      "Clases en la plataforma virtual",
      "Acceso a clases grabadas y foros",
      "Biblioteca virtual",
    ],
    description:
      "Clases en plataforma virtual y acceso a material las 24 horas",
    imagen: "https://www.placehold.co/600x400?text=Virtual",
  },
  {
    id: 3,
    codigo: 8,
    color: "--azul-dark-ucasal",
    nombre: "home",
    caracteristicas: [
      "Clases en la plataforma virtual",
      "Acceso a clases grabadas y foros",
      "Exámenes 100% virtuales",
    ],
    description:
      "Clases en plataforma virtual y acceso a material las 24 horas",
    imagen: "https://www.placehold.co/600x400?text=Home",
  },
];

// Una carrera se dicta en 1 y/o 7; Home es una variante del cursado online, así
// que la puerta Home solo tiene sentido si la carrera se vende online.
const puertasDeLaCarrera = modosCarrera
  ? modosCarrera.flatMap((modo) =>
      modo === MODO_ONLINE ? [MODO_ONLINE, MODO_HOME] : [modo],
    )
  : null;

// La landing online no vende presencial: ahí quedan solo Online y Home. Cuáles
// entran lo decide src/config/modalidad.ts según el build. Y si nos pasaron los
// modos de una carrera, se recorta además a los de esa carrera.
const modalidades = todasLasModalidades.filter(
  (m) =>
    modosPuerta.includes(m.codigo) &&
    (!puertasDeLaCarrera || puertasDeLaCarrera.includes(m.codigo)),
);
---

<section id="modalidades" class="seccion-snap flex flex-col">
  <h2 class="text-3xl font-bold text-center mb-8">{titulo}</h2>
  <div class="contenedor mx-auto flex-1 w-full flex flex-col min-h-0">
    <div class="flex max-md:flex-col flex-1 min-h-0 overflow-hidden pb-16">
      {
        modalidades.map((modalidad, i) => (
          <article
            {/* Sin `capitalize` en el panel: ponía en mayúscula cada palabra
                de la descripción. Solo el nombre de la modalidad lo necesita. */}
            class="puerta-panel relative overflow-hidden bg-cover bg-center"
            style={`background-image:url(${modalidad.imagen})`}
            data-index={i}
            data-active={i === 0 ? "true" : "false"}
          >
            <div class="absolute inset-0 bg-linear-to-t from-(--azul-dark-ucasal)/95 via-(--azul-dark-ucasal)/35 to-(--azul-dark-ucasal)/10" />

            <button class={`puerta-colapsado absolute inset-0 flex flex-col items-center justify-between py-7 cursor-pointer bg-(${modalidad.color}) ${modalidad.codigo === 7 ? "bg-[#1c4d86]" : ""}`}>
              <span class="text-[10px] font-semibold tracking-[0.2em] text-white/80 uppercase">
                0{i + 1}
              </span>
              <span class="text-3xl md:text-4xl font-black tracking-tight first-letter:uppercase text-white">
                {modalidad.nombre}
              </span>
              <span class="text-[10px] font-semibold tracking-[0.16em] text-white/80 uppercase">
                Ver
              </span>
            </button>

            <div class="puerta-expandido absolute inset-x-0 bottom-0 flex-col items-start gap-2 md:gap-4 py-10 px-4 md:px-10">
              <h3 class="capitalize text-white">{modalidad.nombre}</h3>
              <p class="max-w-[40ch] text-base md:text-lg leading-relaxed text-white/90">
                {modalidad.description}
              </p>
              <ul class="flex flex-col gap-1.5 pt-0.5">
                {modalidad.caracteristicas.map((caracteristica) => (
                  <li class="flex items-center gap-2.5 text-sm font-medium text-white/90 normal-case">
                    <span class={`h-1.5 w-1.5 flex-none ${modalidad.codigo === 7 ? 'bg-[#1c4d86]' : `bg-(${modalidad.color})`}`}/>
                    {caracteristica}
                  </li>
                ))}
              </ul>
              {modalidad.id === 3 && (
                <p class="text-xs text-white/80 mt-2">
                  * Modalidad disponible solo para estudiantes que estén a más de 100km de cualquier sede.
                </p>
              )}
              <a
                href={destinoCta}
                class={`puerta-cta mt-2 flex md:min-w-87.5 items-center justify-between gap-6 ${modalidad.codigo === 7 ? 'bg-[#1c4d86] hover:bg-[#1c4d86]/90' : `bg-(${modalidad.color}) hover:bg-(${modalidad.color})/90`} p-3 md:px-4.5 md:py-4 text-xs md:text-sm font-bold text-white normal-case transition-colors hover:bg-white hover:text-(--azul-dark-ucasal)`}
                data-codigo={modalidad.codigo === 8 ? 7 : modalidad.codigo}
              >
                {textoCta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .puerta-panel {
    flex-grow: 0.5;
    flex-basis: 0;
    transition: flex-grow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    @media (min-width: 640px) {
      flex-grow: 1;
    }
  }
  .puerta-panel[data-active="true"] {
    flex-grow: 1.5;
    @media (min-width: 640px) {
      flex-grow: 2;
    }
  }
  .puerta-colapsado {
    display: flex;
  }
  .puerta-expandido {
    display: none;
  }
  .puerta-panel[data-active="true"] .puerta-colapsado {
    display: none;
  }
  .puerta-panel[data-active="true"] .puerta-expandido {
    display: flex;
  }
  .puerta-panel:not([data-active="true"]) .puerta-cta {
    pointer-events: none;
  }
</style>

<script>
  const paneles = Array.from(document.querySelectorAll(".puerta-panel"));

  paneles.forEach((panel) => {
    panel.addEventListener("click", () => {
      paneles.forEach((p) =>
        p.setAttribute("data-active", String(p === panel)),
      );
    });
  });

  paneles.forEach((panel) => {
    const cta = panel.querySelector(".puerta-cta");
    cta?.addEventListener("click", (e) => {
      if (panel.dataset.active !== "true") {
        e.preventDefault();
        return;
      }
      window.dispatchEvent(
        new CustomEvent("preselect-modalidad", {
          detail: { code: Number(cta.dataset.codigo) },
        }),
      );
    });
  });
</script>
