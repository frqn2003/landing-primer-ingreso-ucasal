---
const testimonios = [
  {
    nombre: "Benjamin Elizalde",
    carrera: "Licenciatura en Comercialización",
    frase: "La facultad está siempre a disposición",
  },
  {
    nombre: "Ebaneo Valdez Kao",
    carrera: "Ingeniería en Informática",
    frase: "Puedo ejercer mi profesión desde cualquier parte del mundo",
  },
  {
    nombre: "Luciana Gennari",
    carrera: "Kinesiología",
    frase:
      "Para poder rendir bien académicamente y en entrenamiento, la universidad me da una ayuda gigante",
  },
  {
    nombre: "Nicolás Ovejero",
    carrera: "Licenciatura en Turismo",
    frase:
      "Le agradezco a la universidad por brindarnos una herramienta fundamental: el capital humano, los profesores y sobre todo los compañeros",
  },
  {
    nombre: "Nahuel Agustín Artigas",
    carrera: "Profesorado en Educación Física",
    frase:
      "Son todos sentimientos de alegría y felicidad porque pude realizar un sueño que tenía, que era recibirme",
  },
  {
    nombre: "Luciano Marcelo Sato",
    carrera: "Licenciatura en Artes Musicales",
    frase:
      "Nos permite integrarnos muy fácil al mundo laboral en muchos aspectos, capacitándonos mucho en el día a día",
  },
  {
    nombre: "Tania Elizabeth Flores",
    carrera: "Corredor Inmobiliario y Martillero Público",
    frase:
      "El apoyo de los profesores y del equipo UCASAL es fundamental: siempre están para guiarte. Como mamá, valoro mucho esa ayuda para equilibrar familia, trabajo y estudio.",
  },
];
---

<div
  class="testimonio-widget w-full max-w-md rounded-3xl border border-white/20 bg-white/10 p-6 shadow-2xl backdrop-blur-md"
>
  <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.2em] text-black md:text-white/70">
    Lo que dicen nuestros estudiantes
  </p>
  <div class="testimonio-track mt-5 min-h-33">
    {
      testimonios.map((t, i) => (
        <div
          class="testimonio-item flex flex-col gap-3"
          data-index={i}
          style={i === 0 ? "" : "display:none"}
        >
          <p class="text-lg leading-7 text-black md:text-white">“{t.frase}”</p>
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-(--rojo-ucasal) font-bold text-white">
              {t.nombre.charAt(0)}
            </span>
            <div>
              <p class="font-bold text-black md:text-white">{t.nombre}</p>
              <p class="text-sm text-black/70 md:text-white/70">{t.carrera}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="mt-5 flex items-center justify-center gap-2">
    {
      testimonios.map((_t, i) => (
        <button
          type="button"
          class="testimonio-dot h-2 w-2 rounded-full bg-black/40 md:bg-white/40 transition-colors"
          data-index={i}
          aria-label={`Testimonio ${i + 1}`}
        />
      ))
    }
  </div>
</div>

<style>
  .testimonio-dot[data-active="true"] {
    background: var(--rojo-ucasal);
    width: 1.25rem;
    border-radius: 9999px;
  }
</style>


<script>
    document.querySelectorAll<HTMLElement>(".testimonio-widget").forEach((widget) => {
        const items = Array.from(widget.querySelectorAll<HTMLElement>(".testimonio-item"));
        const dots = Array.from(widget.querySelectorAll<HTMLElement>(".testimonio-dot"));
        const total = items.length;
        let activo = 0;
        let temporizador: ReturnType<typeof setInterval>;

        function mostrar(indice: number) {
            activo = ((indice % total) + total) % total;
            items.forEach((item, i) => {
                item.style.display = i === activo ? "" : "none";
            });
            dots.forEach((dot, i) => {
                dot.dataset.active = String(i === activo);
            });
        }

        function reiniciarAutoplay() {
            clearInterval(temporizador);
            temporizador = setInterval(() => mostrar(activo + 1), 6000);
        }

        dots.forEach((dot, i) => {
            dot.addEventListener("click", () => {
                mostrar(i);
                reiniciarAutoplay();
            });
        });

        mostrar(0);
        reiniciarAutoplay();
    });
</script>