---
// Cinta de convenios: una sola línea que se desplaza sin fin, con varios
// convenios a la vista al mismo tiempo.
//
// Por qué una cinta y no un carrusel por pasos: son casi veinte logos y el
// pedido era que quepan en una línea. Un carrusel obliga a esperar (o a tocar
// flechas) para ver el resto; la cinta los muestra todos sin intervención, y al
// no tener estados ni controles no necesita JavaScript.
//
// Cómo se logra el "sin fin": la pista lleva la lista dos veces y se desplaza
// exactamente la mitad de su ancho. Cuando termina, el primer ítem de la copia
// está justo donde arrancó el original, así que el reinicio no se ve. La copia
// va aria-hidden para que el lector de pantalla lea la lista una sola vez.
//
// El espacio entre ítems es padding de cada ítem y no un `gap` de la pista: con
// `gap`, el 50% no coincide con el ancho de una copia (queda medio hueco de
// diferencia) y el salto se nota en cada vuelta.
import { Image } from "astro:assets";
import { convenios, type Convenio } from "../../data/convenios";

// Los logos vectoriales van en `src/assets/convenios/` y entran acá como texto,
// para pegarlos dentro del HTML en vez de pedirlos como imagen: así el CSS
// llega a las figuras de adentro. Ojo con esto: solo sirve para vectores de
// verdad. Catorce de estos "SVG" eran en realidad un PNG de 8333px en base64
// adentro de un wrapper `<svg>`, y pegarlos inline metía 153 MB de texto en
// cada página (por dos, por la copia de la cinta): el build terminaba en 26 GB.
// Ahora esos son `.webp` en la misma carpeta y salen por `<Image>`.
// La clave de los mapas es el nombre del archivo, que es lo último de `logo` en
// el dato, así `convenios.ts` no cambia de forma.
const svgsCrudos = import.meta.glob<string>("../../assets/convenios/*.svg", {
    query: "?raw",
    import: "default",
    eager: true,
});

// Illustrator exporta cada logo con un `<style>` adentro del SVG (`.st0`,
// `.st1`, `.cls-1`…) y un `id="Capa_1"` en la raíz. Pegado inline eso rompe dos
// veces:
//
//  - El `<style>` de un SVG inline no está encapsulado: es CSS del documento.
//    Los siete logos declaran `.st0`, así que todos terminaban pintados con el
//    color del último que parseaba el navegador (`.st0` vale #2bb2e4, #24499c,
//    #232b52, #1628ae, #244081 o #0d8b3a según el archivo).
//  - `id="Capa_1"` viene repetido en los siete, y la cinta duplica la lista, así
//    que el HTML salía con catorce elementos con el mismo id.
//
// Por eso el `<style>` se resuelve acá, en build: cada regla baja a atributos de
// presentación sobre el elemento que la usaba (`fill`, `fill-rule` y `font-*`
// mapean uno a uno) y el bloque desaparece. Sin CSS de por medio el logo queda
// autocontenido, que es justo lo que hace falta para el `<symbol>` de abajo:
// dentro de un `<use>` los selectores del documento no llegan, los atributos sí.
const desarmarSvg = (crudo: string) => {
    // El prólogo XML sólo vale cuando el SVG es un archivo suelto; en medio del
    // HTML sobra, igual que el comentario del exportador.
    let svg = crudo
        .replace(/<\?xml[\s\S]*?\?>/i, "")
        .replace(/<!--[\s\S]*?-->/g, "")
        .trim();

    // clase -> propiedad -> valor. Recorre las reglas en orden de aparición y
    // sobrescribe, para que gane la última declaración como haría la cascada.
    const porClase = new Map<string, Map<string, string>>();

    svg = svg.replace(/<style[^>]*>([\s\S]*?)<\/style>/gi, (_, css: string) => {
        for (const [, selectores, cuerpo] of css.matchAll(
            /([^{}]+)\{([^{}]*)\}/g,
        )) {
            for (const selector of selectores.split(",")) {
                const nombre = selector.trim();
                if (!nombre.startsWith(".")) continue;
                const clase = nombre.slice(1);
                const props = porClase.get(clase) ?? new Map<string, string>();
                for (const declaracion of cuerpo.split(";")) {
                    const corte = declaracion.indexOf(":");
                    if (corte === -1) continue;
                    props.set(
                        declaracion.slice(0, corte).trim(),
                        declaracion.slice(corte + 1).trim(),
                    );
                }
                porClase.set(clase, props);
            }
        }
        return "";
    });

    svg = svg.replace(/\s+class="([^"]*)"/g, (_, clases: string) => {
        const props = new Map<string, string>();
        for (const clase of clases.trim().split(/\s+/)) {
            for (const [prop, valor] of porClase.get(clase) ?? []) {
                props.set(prop, valor);
            }
        }
        return [...props].map(([prop, valor]) => ` ${prop}="${valor}"`).join("");
    });

    // El `viewBox` pasa al `<symbol>`; el `id="Capa_1"` de la raíz se va con la
    // etiqueta `<svg>`, y el `<defs>` queda vacío al sacarle el `<style>`.
    const viewBox = svg.match(/\sviewBox="([^"]*)"/i)?.[1] ?? "0 0 512 512";
    const cuerpo = svg
        .replace(/^<svg[^>]*>/i, "")
        .replace(/<\/svg>\s*$/i, "")
        .replace(/<defs\s*>\s*<\/defs>/gi, "")
        .trim();

    return { viewBox, cuerpo };
};

const vectorPorArchivo = new Map(
    Object.entries(svgsCrudos).map(([ruta, crudo]) => [
        ruta.split("/").pop() as string,
        desarmarSvg(crudo),
    ]),
);

const archivoDe = (convenio: Convenio) => convenio.logo?.split("/").pop() ?? "";

const vectorDe = (convenio: Convenio) => vectorPorArchivo.get(archivoDe(convenio));

// Los logos que son foto y no vector. Van por el pipeline de imágenes de Astro
// (avif/webp y srcset), no inline.
const rasters = import.meta.glob<ImageMetadata>(
    "../../assets/convenios/*.webp",
    { import: "default", eager: true },
);

const rasterPorArchivo = new Map(
    Object.entries(rasters).map(([ruta, imagen]) => [
        ruta.split("/").pop() as string,
        imagen,
    ]),
);

const rasterLocal = (convenio: Convenio) =>
    rasterPorArchivo.get(convenio.logo?.split("/").pop() ?? "");

interface Props {
    /**
     * "seccion": banda propia sobre fondo claro, con el título como h2.
     * "franja": sin fondo ni bordes y con los logos en blanco, para colgarla
     * dentro de un bloque oscuro (así la usa Testimonios.astro).
     */
    variante?: "seccion" | "franja";
    base?: string;
}

const { variante = "seccion", base = import.meta.env.BASE_URL } = Astro.props;

const enFranja = variante === "franja";

// Dentro del panel oscuro el título es un rótulo chico arriba de los logos, no
// el encabezado de la sección: ahí el h2 es el de los testimonios.
const Titulo = enFranja ? "p" : "h2";

// Ritmo constante: si mañana entran más convenios, la cinta se hace más larga
// pero se sigue moviendo a la misma velocidad en vez de acelerarse.
const SEGUNDOS_POR_CONVENIO = 3.2;
const duracion = `${(convenios.length * SEGUNDOS_POR_CONVENIO).toFixed(1)}s`;

// Un `<symbol>` por logo, no uno por aparición. La cinta necesita la lista dos
// veces (ver arriba) y con el SVG pegado el trazado viajaba duplicado: 93 KB de
// SVG inline por página, la mitad puro clon. Ahora los trazados van una sola vez
// en un sprite escondido y cada aparición es un `<use>` de treinta bytes.
//
// Los ids llevan la variante porque el componente podría entrar dos veces en la
// misma página (hoy sólo lo monta Testimonios, pero "seccion" existe para usarla
// suelta) y dos sprites con los mismos ids se pisarían.
const idSimbolo = (archivo: string) =>
    `convenio-${variante}-${archivo.replace(/\.svg$/i, "").toLowerCase()}`;

// Sólo los logos que la cinta realmente muestra, sin repetir.
const sprite = [...new Set(convenios.map(archivoDe))]
    .filter((archivo) => vectorPorArchivo.has(archivo))
    .map((archivo) => {
        const { viewBox, cuerpo } = vectorPorArchivo.get(archivo)!;
        return `<symbol id="${idSimbolo(archivo)}" viewBox="${viewBox}">${cuerpo}</symbol>`;
    })
    .join("");
---

<section
    id="convenios"
    class:list={[
        enFranja ? "franja mt-14" : "border-y border-slate-200 bg-white py-12",
    ]}
    aria-labelledby="convenios-titulo"
>
    <Titulo
        id="convenios-titulo"
        class:list={[
            "text-center",
            enFranja
                ? "text-xs font-bold uppercase tracking-[0.2em] text-(--azul-ucasal) sm:text-sm"
                : "contenedor text-2xl font-black text-(--azul-dark-ucasal) sm:text-3xl",
        ]}
    >
        Aranceles bonificados con estos convenios
    </Titulo>

    <!-- Los trazados de los logos, una sola vez para toda la página: la cinta y
         su copia los traen con `<use>`. Fuera de la pantalla en vez de
         `display: none` porque algunos navegadores no resuelven el `<use>` si el
         sprite está sin renderizar. -->
    <svg class="sprite" aria-hidden="true" set:html={sprite} />

    <!-- La máscara desvanece los bordes: sin ella la cinta se corta de golpe
         contra los costados de la pantalla. -->
    <div class:list={["cinta-zona", enFranja ? "mt-6" : "mt-8"]}>
        <div class="cinta bg-(--azul-ucasal)/15 p-4 border border-(--azul-ucasal)/50" style={`--duracion: ${duracion}`}>
            {
                [false, true].map((esCopia) => (
                    <ul class="tira" aria-hidden={esCopia ? "true" : undefined}>
                        {convenios.map((convenio) => {
                            const vector = vectorDe(convenio);
                            const raster = rasterLocal(convenio);
                            return (
                                <li class="convenio">
                                    {vector ? (
                                        <svg viewBox={vector.viewBox}>
                                            <use
                                                href={`#${idSimbolo(archivoDe(convenio))}`}
                                            />
                                        </svg>
                                    ) : raster ? (
                                        <Image
                                            src={raster}
                                            alt={convenio.nombre}
                                            widths={[144, 288, 432]}
                                            sizes="9rem"
                                            loading="lazy"
                                            class="convenio-logo"
                                        />
                                    ) : convenio.logo ? (
                                        <img
                                            src={`${base}${convenio.logo}`}
                                            alt={convenio.nombre}
                                            loading="lazy"
                                            decoding="async"
                                            class="convenio-logo"
                                        />
                                    ) : (
                                        /* Sin archivo de logo todavía: el nombre
                                           mantiene la cinta completa y legible. */
                                        <span class="convenio-nombre">{convenio.nombre}</span>
                                    )}
                                </li>
                            );
                        })}
                    </ul>
                ))
            }
        </div>
    </div>
</section>

<style>
    .sprite {
        position: absolute;
        width: 0;
        height: 0;
        overflow: hidden;
    }

    .cinta-zona {
        /* Cuánto se desvanece cada borde. En mobile va corto a propósito: con
           6rem por lado, en una pantalla de 375px el desvanecido se comería más
           de la mitad del ancho. */
        --desvanecido: 2rem;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            black var(--desvanecido),
            black calc(100% - var(--desvanecido)),
            transparent
        );
        mask-image: linear-gradient(
            to right,
            transparent,
            black var(--desvanecido),
            black calc(100% - var(--desvanecido)),
            transparent
        );
    }

    @media (min-width: 768px) {
        .cinta-zona {
            --desvanecido: 6rem;
        }
    }

    .cinta {
        display: flex;
        width: max-content;
        animation: correr var(--duracion) linear infinite;
    }

    /* Al pasar el mouse o al llegar con el teclado se detiene, para poder leer
       un convenio en particular. */
    .cinta-zona:hover .cinta,
    .cinta-zona:focus-within .cinta {
        animation-play-state: paused;
    }

    @keyframes correr {
        to {
            transform: translateX(-50%);
        }
    }

    .tira {
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .convenio {
        display: flex;
        height: 3.5rem;
        flex: none;
        align-items: center;
        justify-content: center;
        padding-inline: 1.25rem;
    }

    @media (min-width: 768px) {
        .convenio {
            height: 4rem;
            padding-inline: 2rem;
        }
    }

    /* El `<svg>` pegado se nombra con `:global` porque entra por `set:html` y
       Astro no le pone la marca del estilo con ámbito. El `.convenio` de
       adelante sí la lleva, así que la regla no se escapa del componente. */
    .convenio-logo,
    .convenio :global(svg) {
        max-height: 100%;
        width: auto;
        max-width: 9rem;
        object-fit: contain;
        color: white;
    }

    /* El alto lo pone la cinta y el ancho sale de la proporción del viewBox. */
    .convenio :global(svg) {
        height: 100%;
    }

    .convenio-nombre {
        display: flex;
        align-items: center;
        height: 2.5rem;
        white-space: nowrap;
        border: 1px solid var(--ucasal-gray-medium);
        border-radius: 0.75rem;
        padding-inline: 1rem;
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--azul-ucasal);
        background: var(--ucasal-gray-light);
    }

    /* ── Variante para el panel oscuro ────────────────────────────────────── */

    .franja .convenio-nombre {
        border-color: rgb(255 255 255 / 0.2);
        background: rgb(255 255 255 / 0.08);
        color: var(--ucasal-white);
    }


    .franja .convenio:hover .convenio-logo,
    .franja .convenio:hover :global(svg) {
        opacity: 1;
    }

    /* Sin movimiento: la cinta se queda quieta y se recorre a mano. Se muestra
       una sola copia para no repetir la lista al scrollear. */
    @media (prefers-reduced-motion: reduce) {
        .cinta-zona {
            overflow-x: auto;
        }

        .cinta {
            animation: none;
        }

        .tira[aria-hidden="true"] {
            display: none;
        }
    }
</style>
