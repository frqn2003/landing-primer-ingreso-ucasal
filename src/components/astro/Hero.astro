---
interface Props {
    base?: string;
}

const { base = import.meta.env.BASE_URL } = Astro.props;
---

<section class="relative w-full text-white" aria-labelledby="hero-title">
    <!-- Foto de fondo, ocupa toda la altura de la pantalla -->
    <div class="relative h-screen w-full overflow-hidden lg:h-dvh lg:min-h-screen">
        <picture>
            <source media="(min-width: 769px)" srcset={`${base}encabezados/mundial/desktop.webp`} />
            <img
                src={`${base}encabezados/mundial/mobile.webp`}
                alt=""
                class="absolute inset-0 h-full w-full object-cover"
            />
        </picture>
        <div class="absolute inset-0 bg-linear-to-t from-(--azul-dark-ucasal)/90 via-(--azul-dark-ucasal)/25 to-transparent"></div>
        <div class="absolute inset-x-0 top-0 h-32 bg-linear-to-b from-black/55 to-transparent lg:h-40"></div>

        <div class="md:mx-12 py-14 h-full mx-5 absolute inset-x-0 bottom-0 flex flex-col items-center gap-4">
            <div class="max-w-4xl flex flex-col justify-center my-auto items-center">
                <h1 class="uppercase">Estudia, conectá, crecé</h1>
                <p class="text-center">Descripción epicarda</p>
            </div>
            <div class="flex flex-row gap-4">
                <a href={`${base}#carreras`} class="boton-cta outline-2 outline-white/20 outline-offset-6 uppercase bg-(--rojo-ucasal) text-white group">Comienza ahora</a>
            </div>
        </div>
    </div>
</section>

