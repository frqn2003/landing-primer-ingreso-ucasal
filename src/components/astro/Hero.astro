---
interface Props {
    base?: string;
}

const { base = import.meta.env.BASE_URL } = Astro.props;
import Testimonios from "./Testimonios.astro";
---

<section class="relative w-full text-white" aria-labelledby="hero-title">
    <!-- Foto de fondo, ocupa toda la altura de la pantalla -->
    <div class="relative h-screen w-full overflow-hidden lg:h-dvh lg:min-h-screen">
        <picture>
            <source media="(min-width: 769px)" srcset={`${base}encabezados/mundial/desktop.webp`} />
            <img
                src={`${base}encabezados/mundial/mobile.webp`}
                alt=""
                class="absolute inset-0 h-full w-full object-cover"
            />
        </picture>
        <div class="absolute inset-0 bg-linear-to-t from-(--azul-dark-ucasal)/90 via-(--azul-dark-ucasal)/25 to-transparent"></div>
        <div class="absolute inset-x-0 top-0 h-32 bg-linear-to-b from-black/55 to-transparent lg:h-40"></div>

        <div class="md:mx-12 mx-5 absolute inset-x-0 bottom-0 pb-8 md:pb-14 lg:flex lg:items-end lg:justify-between lg:gap-10">
            <div class="max-w-xl">
                <h1>Estudia, <br>conectá,<br>crecé</h1>
                <div class="mt-4 md:mt-8 flex md:flex-wrap flex-row gap-4">
                    <a href={`${base}#carreras`} class="boton-cta bg-(--rojo-ucasal) text-white">Explorar carreras</a>
                    <a href={`${base}#modalidades`} class="rounded-xl border border-white/40 px-5 py-3 font-semibold text-white transition hover:bg-white hover:text-(--azul-dark-ucasal) max-md:text-sm">Conocer modalidades</a>
                </div>
            </div>
            <div class="hidden lg:block">
                <Testimonios />
            </div>
        </div>
    </div>


    <!-- Mobile: testimonios debajo del hero -->
    <div class="bg-slate-50 px-5 py-10 lg:hidden">
        <Testimonios />
    </div>
</section>

