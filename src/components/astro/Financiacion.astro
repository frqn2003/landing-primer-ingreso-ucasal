---
let tarjetas: any[] = [];
let cargando = true;

try {
    await fetch(
        "https://www.ucasal.edu.ar/landing/ingreso/assets/datosLanding.json",
    )
        .then((r) => r.json())
        .then((data) => {
            const activas: any[] = (data.tarjeta as any[])
                .filter((t) => t.activa)
                .sort((a, b) => a.orden - b.orden);

            tarjetas = activas;
        });
    cargando = false;
    console.log("Cargaron las tarjetas");
} catch (error) {
    console.error("Error al cargar las tarjetas", error);
}
---

<section
    class="bg-center bg-cover justify-center relative"
    role="region"
    aria-label="Financiación"
>
    <div
        class="p-2 md:p-6 flex flex-col gap-12 z-20 rounded-lg"
    >
        <h3
            class="text-2xl md:text-3xl text-center font-semibold"
            style="color:white;"
        >
            Financiá tus aranceles con:
        </h3>
        <div class="flex flex-row md:flex-col gap-6 md:gap-12 h-full justify-around items-center">
            {
                cargando ? (
                    [1, 2, 3].map(() => (
                        <div class="h-24 rounded-xl bg-white/20 animate-pulse flex-1 max-w-100 w-full" />
                    ))
                ) : (
                    <>
                        {tarjetas.map((tarjeta) => (
                            <div class="flex flex-col items-center gap-1 max-w-100 w-full">
                                <div class="bg-white/70 border border-white/80 rounded-xl px-4 py-2 sm:px-6 sm:py-3 flex items-center justify-center">
                                    <img
                                        src={tarjeta.imagen}
                                        alt={tarjeta.nombre}
                                        class="h-11 object-contain"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                                <p class="text-white text-xs sm:text-lg text-center leading-snug">
                                    {tarjeta.descripcion}
                                </p>
                            </div>
                        ))}
                    </>
                )
            }
        </div>
    </div>
</section>
