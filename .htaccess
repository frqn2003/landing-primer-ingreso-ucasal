# ----------------------------------------------------------------------------
# BLOQUE 3 - Landing de AGOSTO retirada -> landing de primer ingreso
# ----------------------------------------------------------------------------
#
# /landing/ingreso/carreras-agosto/ era una SPA aparte (repo landing-agosto,
# react-router). Sus 24 carreras usan exactamente el mismo `slug` que
# src/data/carreras.ts, asi que la unica traduccion es cambiar la base.
#
# Las 23 que se dictan a distancia van al build online; topografia y geomatica
# solo se genera en el build presencial (su `modalidad` no incluye el modo 7),
# asi que va a /landing/ingreso/carreras/.
#
# Todo lo demas de ese arbol -la home, /enviado-agosto, /enviado/<algo>, /404 y
# los assets viejos- cae a la home online: un lead que entra por un link viejo
# aterriza en la landing nueva en vez de comerse un 404.
#
# mod_alias agrega el query string solo cuando el destino no trae uno propio, y
# aca ninguno lo trae: los utm_* de las campanias de agosto sobreviven al salto.
#
# IMPORTANTE - mientras la carpeta carreras-agosto siga en el servidor, estas
# reglas NO alcanzan: ese directorio tiene su propio .htaccess con el rewrite
# de la SPA (RewriteRule ^ index.html [L]), mod_rewrite corre antes que
# mod_alias y por defecto un .htaccess hijo no hereda las reglas del padre.
# Hay que subir tambien deploy/carreras-agosto.htaccess, que reemplaza ese
# archivo. Este bloque es la red de contencion para cuando la carpeta se borre.

RedirectMatch 301 ^/landing/ingreso/carreras-agosto/tecnicatura-universitaria-topografia-y-geomatica/?$ /landing/ingreso/carreras/tecnicatura-universitaria-topografia-y-geomatica

RedirectMatch 301 ^/landing/ingreso/carreras-agosto/(abogacia|administracion-agropecuaria|administracion-de-empresas|administracion-de-negocios-digitales|comercializacion|comercio-internacional|contador-publico|corredor-inmobiliario-y-martillero-publico|economia|escribania|guia-universitario-de-turismo|higiene-y-seguridad|licenciatura-en-ciencia-de-datos|licenciatura-en-corretaje-tasacion-y-administracion-de-consorcios|licenciatura-en-seguridad|procuracion|recursos-humanos|tec-universitaria-en-gestion-de-bancos-empresas-financieras-y-de-seguros|tecn-univ-en-organizacion-y-direccion-de-eventos-y-ceremonial|tecnicatura-en-operaciones-mineras-e-industriales|tecnicatura-en-seguridad-informatica|tecnicatura-univ-en-gestion-de-calidad|tecnicatura-univ-en-secretariado-ejecutivo)/?$ /landing/ingreso/carreras-online/$1

RedirectMatch 301 ^/landing/ingreso/carreras-agosto(/.*)?$ /landing/ingreso/carreras-online/

# ----------------------------------------------------------------------------
# SIN DESTINO - la carrera NO existe en src/data/carreras.ts
# ----------------------------------------------------------------------------
# Descomentar cuando se cargue la carrera en el proyecto, o decidir a donde
# mandarlas (el listado /landing/ingreso/carreras/ es el fallback razonable).
#
# 221-LICENCIATURA EN DISENO GRAFICO
# Redirect 301 /landing/estudiar-lic-diseno-grafico-presencial.php /landing/ingreso/carreras/
#
# 180-LICENCIATURA EN HISTORIA - CICLO DE LICENCIATURA
# Redirect 301 /landing/estudiar-lic-historia-ciclo-licenciatura.php /landing/ingreso/carreras/
#
# 203-LICENCIATURA EN ARTES PLASTICAS - CICLO LICENCIATURA
# Redirect 301 /landing/estudiar-lic-artes-plasticas-presencial.php /landing/ingreso/carreras/
#
# 389-LICENCIATURA EN REALIZACION AUDIOVISUAL
# Redirect 301 /landing/estudiar-licenciatura-en-realizacion-audiovisual.php /landing/ingreso/carreras/
#
# Sin URL de origen en la planilla (no se puede redirigir): 193, 2, 216, 245,
# 27, 335, 339, 350, 41, 9, 96.
