{
  "name": "landing-primer-ingreso",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --mode presencial",
    "dev:online": "node scripts/dev-online.mjs",
    "build": "npm run build:presencial && npm run build:online",
    "build:presencial": "astro build --mode presencial outDir",
    "build:online": "astro build --mode online outDir",
    "preview": "astro preview --mode presencial outDir",
    "preview:online": "astro preview --mode online outDir --port 4322",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@microsoft/clarity": "^1.0.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.7",
    "intl-tel-input": "^29.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  }
}
